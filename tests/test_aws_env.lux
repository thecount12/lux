// Parser / timestamp helpers from lib/aws.lux (no live AWS calls).
import "../lib/aws.lux";

print "=== AWS env loader test ===";

var sample = "[960491734164_AccountAdmin]\n" +
    "aws_access_key_id=ASIA123\n" +
    "aws_secret_access_key=secret-value\n" +
    "aws_session_token=session-value\n" +
    "region=us-west-2\n" +
    "bucket=my-bucket\n";
writeFile("_aws_env_test.txt", sample);

var cfg = loadAwsCredentials("_aws_env_test.txt");
assert(cfg != nil, "credentials loaded");
assert(cfg.accessKey == "ASIA123", "access key");
assert(cfg.secretKey == "secret-value", "secret");
assert(cfg.sessionToken == "session-value", "session token");
assert(cfg.region == "us-west-2", "region");
assert(cfg.bucket == "my-bucket", "bucket");

var quoted = "AWS_ACCESS_KEY_ID=\"AKIATEST\"\nAWS_SECRET_ACCESS_KEY='shh'\n";
writeFile("_aws_env_test.txt", quoted);
var cfg2 = loadAwsCredentials("_aws_env_test.txt");
assert(cfg2 != nil, "uppercase keys loaded");
assert(cfg2.accessKey == "AKIATEST", "quoted access key");
assert(cfg2.secretKey == "shh", "quoted secret");
assert(cfg2.sessionToken == nil, "no token");

var iso = awsIsoUtc(0);
assert(iso == "1970-01-01T00:00:00Z", "epoch 0 iso");
var iso2 = awsIsoUtc(86461);
assert(iso2 == "1970-01-02T00:01:01Z", "day+1m+1s iso");

var encoded = awsFormEncode("AWS/Lambda");
assert(encoded == "AWS%2FLambda", "slash encoded");
assert(awsFormEncode("v1:0") == "v1%3A0", "colon encoded");
assert(awsFormEncode("a%2Fb") == "a%252Fb", "percent encoded");

var br = awsBedrockConverseUris("anthropic.claude-sonnet-4-20250514-v1:0");
assert(br.path == "/model/anthropic.claude-sonnet-4-20250514-v1:0/converse", "bedrock http path");
assert(br.uri == "/model/anthropic.claude-sonnet-4-20250514-v1%3A0/converse", "bedrock sign uri");
var brArn = awsBedrockConverseUris("arn:aws:bedrock:us-west-2:1:inference-profile/us.model:0");
assert(strFind(brArn.path, "%2F") >= 0, "arn slash in http path");
assert(strFind(brArn.path, ":") >= 0, "arn colon literal in http path");
assert(strFind(brArn.uri, "%252F") >= 0, "arn slash double-encoded for sign");
assert(strFind(brArn.uri, "%3A") >= 0, "arn colon encoded for sign");
assert(awsBedrockArnRegion("anthropic.claude-sonnet-4-5-20250929-v1:0") == nil, "model id has no arn region");
assert(awsBedrockArnRegion("arn:aws:bedrock:us-west-2:060395286242:inference-profile/us.anthropic.x:0") == "us-west-2", "us profile arn region");
assert(awsBedrockArnRegion("arn:aws:bedrock:us-west-2:060395286242:inference-profile/global.anthropic.x:0") == "us-west-2", "global profile arn region");
var brClient = BedrockRuntimeClient(AwsConfig("AKIA", "secret", "us-east-1", nil));
assert(brClient.hostFor("anthropic.x:0") == "bedrock-runtime.us-east-1.amazonaws.com", "host from config");
assert(brClient.hostFor("arn:aws:bedrock:us-west-2:1:inference-profile/us.x:0") == "bedrock-runtime.us-west-2.amazonaws.com", "host from arn");

var cwXml = "<GetMetricStatisticsResponse><Datapoints>" +
    "<member><Timestamp>2026-01-01T00:00:00Z</Timestamp><Average>10.5</Average></member>" +
    "<member><Timestamp>2026-01-01T00:05:00Z</Timestamp><Average>20</Average></member>" +
    "</Datapoints></GetMetricStatisticsResponse>";
var cw = CloudWatchClient(AwsConfig("AKIA", "secret", "us-east-1", nil));
var series = cw.parseSeries(cwXml, "Average");
assert(series != nil, "parseSeries ok");
assert(series.timestamps.length == 2, "two timestamps");
assert(series.values[0] == "10.5", "first average");
assert(cw.lastDatapoint(cwXml, "Average") == "20", "last datapoint");
assert(cw.parseSeries("<ErrorResponse><Error><Code>X</Code></Error></ErrorResponse>", "Average") == nil, "error xml");

deleteFile("_aws_env_test.txt");
print "All AWS env tests passed";
