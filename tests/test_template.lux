/* Native renderTemplate(path, ctx) — self-contained (any cwd). */

class TplCtx {
  init(title, items) {
    this.title = title;
    this.items = items;
  }
}

createDir("_tpl_test");
writeFile("_tpl_test/footer.tpl", "<footer>foot</footer>\n");
writeFile("_tpl_test/index.tpl",
  "<title>{{ title }}</title>\n" +
  "<ul>\n" +
  "{% for item in items %}\n" +
  "<li>{{ item }}</li>\n" +
  "{% endfor %}\n" +
  "</ul>\n" +
  "{% include \"footer.tpl\" %}\n" +
  "<p>missing={{ nope }}</p>\n");

var ctx = TplCtx("T <ok>", ["One&", "Two"]);
var html = renderTemplate("_tpl_test/index.tpl", ctx);

assert(strFind(html, "<title>T &lt;ok&gt;</title>") >= 0, "title escaped");
assert(strFind(html, "<li>One&amp;</li>") >= 0, "for item escaped");
assert(strFind(html, "<li>Two</li>") >= 0, "for item two");
assert(strFind(html, "<footer>foot</footer>") >= 0, "include footer");
assert(strFind(html, "missing=") >= 0, "missing key empty");
assert(strFind(html, "{{ nope }}") == -1, "missing key not left raw");

var html2 = renderTemplate("_tpl_test/index.tpl", ctx);
assert(html2 == html, "cached expand matches");

var missing = renderTemplate("_tpl_test/does-not-exist.tpl", ctx);
assert(strFind(missing, "Template not found") >= 0, "missing template message");

deleteFile("_tpl_test/index.tpl");
deleteFile("_tpl_test/footer.tpl");

print "test_template: ok";
