// Test file I/O native functions for Plan 9

var path = "message.txt";
var text = "Hello from Lux on Plan 9!";

print "Writing to file...";
if (writeFile(path, text)) {
    print "File written successfully.";
} else {
    print "Failed to write file.";
}

print "Reading from file...";
var content = readFile(path);
if (content != nil) {
    print "The file contains:";
    print content;
} else {
    print "Failed to read file.";
}

// Test with longer content
var multiline = "Line 1
Line 2
Line 3
End of file";

print "Writing multiline content...";
if (writeFile("multiline.txt", multiline)) {
    print "Multiline file written.";
    var readBack = readFile("multiline.txt");
    if (readBack != nil) {
        print "Read back:";
        print readBack;
    }
}

