// Comprehensive test for file and directory operations

print "=== File Operations Test ===";
print "";

// Test 1: Create and write a file
print "1. Creating test.txt...";
if (writeFile("test.txt", "Initial content")) {
    print "   ✓ File created";
} else {
    print "   ✗ Failed to create file";
}

// Test 2: Check if file exists
print "2. Checking if test.txt exists...";
if (fileExists("test.txt")) {
    print "   ✓ File exists";
} else {
    print "   ✗ File does not exist";
}

// Test 3: Read the file
print "3. Reading test.txt...";
var content = readFile("test.txt");
if (content != nil) {
    print "   ✓ Content: " + content;
} else {
    print "   ✗ Failed to read file";
}

// Test 4: Append to the file
print "4. Appending to test.txt...";
if (appendFile("test.txt", "\nAppended line")) {
    print "   ✓ Content appended";
} else {
    print "   ✗ Failed to append";
}

// Test 5: Read after append
print "5. Reading after append...";
content = readFile("test.txt");
if (content != nil) {
    print "   ✓ New content: " + content;
} else {
    print "   ✗ Failed to read file";
}

// Test 6: Create a directory
print "6. Creating testdir directory...";
if (createDir("testdir")) {
    print "   ✓ Directory created";
} else {
    print "   ✗ Failed to create directory";
}

// Test 7: Create files in the directory
print "7. Creating files in testdir...";
if (writeFile("testdir/file1.txt", "File 1 content")) {
    print "   ✓ file1.txt created";
}
if (writeFile("testdir/file2.txt", "File 2 content")) {
    print "   ✓ file2.txt created";
}
if (writeFile("testdir/file3.txt", "File 3 content")) {
    print "   ✓ file3.txt created";
}

// Test 8: List directory contents
print "8. Listing testdir contents...";
var dirList = listDir("testdir");
if (dirList != nil) {
    print "   ✓ Directory contents:";
    print dirList;
} else {
    print "   ✗ Failed to list directory";
}

// Test 9: Delete a file
print "9. Deleting test.txt...";
if (deleteFile("test.txt")) {
    print "   ✓ File deleted";
} else {
    print "   ✗ Failed to delete file";
}

// Test 10: Verify deletion
print "10. Verifying test.txt is deleted...";
if (!fileExists("test.txt")) {
    print "   ✓ File no longer exists";
} else {
    print "   ✗ File still exists";
}

print "";
print "=== Test Complete ===";
print "Note: testdir and its contents remain for inspection.";
print "Clean up with: rm -r testdir";
