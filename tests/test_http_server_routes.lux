/* HTTP Server Test - Server class with routing (POSIX only) */
print "=== HTTP Server Routes Test ===";

fun handleRoot(req, res) {
  res.json(parseJSON("{\"message\": \"Hello from Lux!\", \"server\": \"lux/1.0\"}"));
}
fun handleEcho(req, res) {
  var obj = parseJSON("{\"method\": \"\", \"path\": \"\", \"body\": \"\"}");
  obj.method = req.method;
  obj.path = req.path;
  obj.body = req.body;
  res.json(obj);
}

var server = Server(8081);
server.get("/", handleRoot);
server.get("/echo", handleEcho);
server.post("/echo", handleEcho);
print "Starting server...";
server.start();
