class Zoo {
    init() {
        this.aardvark = 1;
        this.baboon = 1;
        this.cat = 1;
        this.donkey = 1;
        this.elephant = 1;
        this.fox = 1;
    }

    ant() { return this.aardvark; } 
    banana() { return this.baboon; } 
    tuna() { return this.cat; } 
    hay() { return this.donkey; } 
    grass() { return this.elephant; } 
    mouse() { return this.fox; }
}

var zoo = Zoo();
var sum = 0;
var start = clock();
while (sum < 100000000) {
    sum = sum + zoo.ant()
            + zoo.banana()
            + zoo.tuna()
            + zoo.hay()
            + zoo.grass()
            + zoo.mouse();
}

print clock() - start;
print sum;

 
//1e+08 = 100,000,000 = Final sum value

//* This is the target value the loop reaches before terminating
//* Written in scientific notation (1 × 10⁸)
//What the Benchmark Tests

//The benchmark.lux file measures method invocation performance on class instances:

//1. Creates a Zoo class with 6 properties (all set to 1) and 6 methods that return those properties
//2. Runs a loop that calls all 6 methods per iteration, summing the results
//3, Continues until sum reaches 100 million
//4. This means:
//* ~16.67 million loop iterations (100M ÷ 6)
//* ~100 million total method calls
//* ~8 million method calls per second (100M ÷ 12.5)
