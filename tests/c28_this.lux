// Chapter 28: The 'this' keyword
// 'this' refers to the instance the method was called on

class Dog {
    init(name) {
        this.name = name;
    }
    
    bark() {
        print this.name + " says Woof!";
    }
    
    wagTail() {
        print this.name + " wags tail";
    }
    
    greet(other) {
        print this.name + " greets " + other.name;
        other.bark();
    }
}

var dog1 = Dog("Rex");
var dog2 = Dog("Spot");

dog1.bark();
dog2.bark();
dog1.greet(dog2);


// 'this' in nested contexts
class Box {
    init(contents) {
        this.contents = contents;
    }
    
    open() {
        print "Opening box...";
        this.printContents();
    }
    
    printContents() {
        print "Contents: " + this.contents;
    }
}

var box = Box("treasure");
box.open();


// Storing and calling methods
class Timer {
    init(seconds) {
        this.seconds = seconds;
    }
    
    tick() {
        if (this.seconds > 0) {
            this.seconds = this.seconds - 1;
            print "Time remaining: ";
            print this.seconds;
            return true;
        } else {
            print "Time's up!";
            return false;
        }
    }
}

var timer = Timer(5);
timer.tick();
timer.tick();
timer.tick();


// Returning 'this' for chaining
class StringBuilder {
    init() {
        this.value = "";
    }
    
    append(str) {
        this.value = this.value + str;
        return this;
    }
    
    toString() {
        return this.value;
    }
}

var result = StringBuilder()
    .append("Hello")
    .append(" ")
    .append("World")
    .append("!")
    .toString();
print result;
