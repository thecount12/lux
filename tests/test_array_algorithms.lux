// Test array search/sort native functions

print "=== Array Algorithms Test ===";
print "";

print "1. Number arrays";
var nums = [9, 2, 7, 1, 5];
print "Original:";
print nums;

var sortedNums = arraySort(nums);
if (sortedNums == nil) {
    print "arraySort failed";
} else {
    print "Sorted:";
    print sortedNums;
}

print "indexOf 7: " + arrayIndexOf(nums, 7);
print "contains 3: " + arrayContains(nums, 3);
print "contains 5: " + arrayContains(nums, 5);
print "binarySearch 7: " + arrayBinarySearch(nums, 7);
print "binarySearch 3: " + arrayBinarySearch(nums, 3);

print "";
print "2. String arrays";
var words = ["pear", "apple", "orange", "banana"];
print "Original:";
print words;

arraySort(words);
print "Sorted:";
print words;

print "indexOf 'orange': " + arrayIndexOf(words, "orange");
print "contains 'kiwi': " + arrayContains(words, "kiwi");
print "binarySearch 'banana': " + arrayBinarySearch(words, "banana");

print "";
print "3. Mixed-type sort should fail";
var mixed = [1, "two", 3];
var mixedResult = arraySort(mixed);
if (mixedResult == nil) {
    print "mixed sort correctly returned nil";
} else {
    print "unexpected mixed sort success";
}

print "";
print "=== Complete ===";
