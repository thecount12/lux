// Chapter 28: Methods and Initializers
// Basic method definition and invocation

class Person {
    sayHello() {
        print "Hello from Person!";
    }
}

var person = Person();
person.sayHello();  // Uses OP_INVOKE optimization


// Methods with parameters
class Calculator {
    add(a, b) {
        return a + b;
    }
    
    multiply(a, b) {
        return a * b;
    }
}

var calc = Calculator();
print calc.add(5, 3);       // 8
print calc.multiply(4, 7);  // 28


// Using 'this' keyword
class Counter {
    increment() {
        this.count = this.count + 1;
    }
    
    getCount() {
        return this.count;
    }
}

var counter = Counter();
counter.count = 0;
counter.increment();
counter.increment();
counter.increment();
print counter.getCount();  // 3


// Method chaining with 'this'
class Builder {
    setName(name) {
        this.name = name;
        return this;
    }
    
    setAge(age) {
        this.age = age;
        return this;
    }
    
    build() {
        print "Name: " + this.name;
        print "Age: ";
        print this.age;
    }
}

Builder().setName("Alice").setAge(30).build();


// More complex example with state
class BankAccount {
    deposit(amount) {
        this.balance = this.balance + amount;
        print "Deposited: ";
        print amount;
        return this.balance;
    }
    
    withdraw(amount) {
        if (this.balance >= amount) {
            this.balance = this.balance - amount;
            print "Withdrew: ";
            print amount;
            return true;
        } else {
            print "Insufficient funds!";
            return false;
        }
    }
    
    getBalance() {
        return this.balance;
    }
}

var account = BankAccount();
account.balance = 100;
account.deposit(50);
account.withdraw(30);
print "Final balance: ";
print account.getBalance();
