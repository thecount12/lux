fun fibFast(n) {
    if (n < 2) return n;
    var a = 0;
    var b = 1;
    var i = 2;
    while (i <= n) {
        var next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return b;
}

var start = clock();
var result = fibFast(35);
var elapsed = clock() - start;
print "Fibonacci(35) = " + result;
print "Time Elapsed: " + elapsed + " seconds";
