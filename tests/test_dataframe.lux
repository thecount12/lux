// Tests for DataFrame quoted CSV parser
import "../lib/dataframe.lux";

var csv1 = "name,age,score\nAlice,30,85\nBob,25,92\nCarol,27,78";
var df1 = read_csv_text(csv1);
assert(df1.names[0] == "name", "header name parsed");
assert(df1.n == 3, "three rows parsed");
assert(df1.cols[0][1] == "Bob", "second row name Bob");

var csv2 = "id,desc\n1,\"widget, large\"\n2,\"gadget, small\"";
var df2 = read_csv_text(csv2);
assert(df2.n == 2, "quoted comma rows");
assert(df2.cols[1][0] == "widget, large", "quoted field retains comma");

var csv3 = "id,quote\n1,\"She said \"\"hello\"\" today\"\n";
var df3 = read_csv_text(csv3);
assert(df3.n == 1, "escaped quote row");
assert(df3.cols[1][0] == "She said \"hello\" today", "escaped quotes unescaped");

var csv4 = "id,notes\n1,\"line1\nline2\"\n2,ok";
var df4 = read_csv_text(csv4);
assert(df4.n == 2, "newline inside quoted field handled");
assert(df4.cols[1][0] == "line1\nline2", "multiline field preserved");

var csv5 = "a,b,c\n1, ,3\n4,,6\n";
var df5 = read_csv_text(csv5);
assert(df5.n == 2, "empty fields parsed");
assert(df5.cols[1][0] == "", "space trimmed to empty string");
assert(df5.cols[1][1] == "", "missing field parsed as empty string");

var quotedSrc = "id,desc\n1,\"widget, large\"\n2,\"gadget, small\"\n";
var dfq = read_csv_text(quotedSrc);
var round = dfq.to_csv();
var dfq2 = read_csv_text(round);
assert(dfq2.n == 2, "quoted to_csv round-trip rows");
assert(dfq2.cols[1][0] == "widget, large", "quoted to_csv round-trip field");

var tmpPath = "_test_dataframe.csv";
writeFile(tmpPath, csv1);
var fromFile = read_csv_file(tmpPath);
assert(fromFile != nil, "read_csv_file loaded");
assert(fromFile.n == 3, "read_csv_file three rows");
deleteFile(tmpPath);

print "test_dataframe: all assertions passed";
