// Float64Array reduction tests. Exit 0 if natives are absent.
if (!float64_available()) {
    print "test_float64: skipped (not available)";
    exit(0);
}

var a = float64_new(4);
float64_fill(a, 2);
assert(float64_get(a, 0) == 2, "fill");
assert(float64_sum(a) == 8, "sum");
assert(float64_mean(a) == 2, "mean");
assert(float64_min(a) == 2, "min fill");
assert(float64_max(a) == 2, "max fill");

float64_set(a, 0, 1);
float64_set(a, 1, 3);
float64_set(a, 2, 5);
float64_set(a, 3, 2);
assert(float64_min(a) == 1, "min");
assert(float64_max(a) == 5, "max");
assert(float64_sum(a) == 11, "sum mixed");

var c = float64_copy(a);
assert(float64_get(c, 2) == 5, "copy");
float64_set(c, 2, 9);
assert(float64_get(a, 2) == 5, "copy is independent");

var sl = float64_slice(a, 1, 3);
assert(float64_sum(sl) == 8, "slice 3+5");

var empty = float64_new(0);
assert(float64_mean(empty) == nil, "mean empty");
assert(float64_min(empty) == nil, "min empty");
assert(float64_max(empty) == nil, "max empty");
assert(float64_sum(empty) == 0, "sum empty");

var x = float64_new(3);
var y = float64_new(3);
float64_set(x, 0, 1);
float64_set(x, 1, 2);
float64_set(x, 2, 3);
float64_fill(y, 10);
var s = float64_add(x, y);
assert(float64_get(s, 0) == 11, "add");
assert(float64_get(x, 0) == 1, "add does not mutate");
var p = float64_mul(x, y);
assert(float64_get(p, 1) == 20, "mul");
float64_axpy(2, x, y);
assert(float64_get(y, 0) == 12, "axpy y0");
assert(float64_get(y, 2) == 16, "axpy y2");

print "test_float64: all assertions passed";
