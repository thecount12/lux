// Logical operators (| and &) treated as logical OR/AND and ternary operator tests
print "=== Logical and Ternary Operators Test ===";

var t = true;
var f = false;

print "Test OR with |:";
if (f | t) {
    print "✓ f | t is true";
} else {
    print "✗ f | t is false";
}

print "Test AND with &:";
if (t & f) {
    print "✗ t & f is true";
} else {
    print "✓ t & f is false";
}

print "Test ternary operator:";
var x = t ? 1 : 2;
print "x=" + x;

var y = f ? 100 : 200;
print "y=" + y;

print "Ternary used as condition:";
if (f ? t : t) {
    print "✓ ternary condition true";
} else {
    print "✗ ternary condition false";
}

print "=== Logical and Ternary Operators Test Complete ===";

