// String indexing tests

var s = "hello";
print s[0];  // h
print s[1];  // e
print s[4];  // o

fun extractChars(text) {
    var i = 0;
    while (i < len(text)) {
        print text[i];
        i = i + 1;
    }
}

extractChars("abc");

// Works with multi-line strings too
var multi = "x
y";
print multi[0]; // x
print multi[1]; // newline
print multi[2]; // y
