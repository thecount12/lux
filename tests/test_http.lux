// HTTP Functions Test
// Tests httpGet, httpPost, httpPut

print "=== HTTP Functions Test ===";
print "";

// Test 1: Simple GET request
print "Test 1: HTTP GET request";
var response = httpGet("https://httpbin.org/get");
if (response != nil) {
    print "✓ GET request successful";
    var data = parseJSON(response);
    if (data != nil) {
        print "✓ Response parsed as JSON";
        print "  URL: " + data.url;
    }
} else {
    print "✗ GET request failed";
}
print "";

// Test 2: POST request with JSON body
print "Test 2: HTTP POST request";
class TestData {
    init(name, value) {
        this.name = name;
        this.value = value;
    }
}

var payload = TestData("test", 42);
var jsonBody = toJSON(payload);
if (jsonBody != nil) {
    var postResp = httpPost("https://httpbin.org/post", jsonBody);
    if (postResp != nil) {
        print "✓ POST request successful";
        var postData = parseJSON(postResp);
        if (postData != nil) {
            print "✓ Response parsed as JSON";
            // httpbin.org echoes back the data we sent
            var sentData = parseJSON(postData.data);
            if (sentData != nil) {
                print "  Echoed name: " + sentData.name;
                print "  Echoed value: " + sentData.value;
            }
        }
    } else {
        print "✗ POST request failed";
    }
}
print "";

// Test 3: PUT request
print "Test 3: HTTP PUT request";
class UpdateData {
    init(id, status) {
        this.id = id;
        this.status = status;
    }
}

var updatePayload = UpdateData(123, "active");
var updateJson = toJSON(updatePayload);
if (updateJson != nil) {
    var putResp = httpPut("https://httpbin.org/put", updateJson);
    if (putResp != nil) {
        print "✓ PUT request successful";
        var putData = parseJSON(putResp);
        if (putData != nil) {
            print "✓ Response parsed as JSON";
            var sentData = parseJSON(putData.data);
            if (sentData != nil) {
                print "  Updated ID: " + sentData.id;
                print "  New status: " + sentData.status;
            }
        }
    } else {
        print "✗ PUT request failed";
    }
}
print "";

// Test 4: Fetch and parse JSON API
print "Test 4: Fetch JSON data from API";
var jsonResp = httpGet("https://jsonplaceholder.typicode.com/todos/1");
if (jsonResp != nil) {
    var todo = parseJSON(jsonResp);
    if (todo != nil) {
        print "✓ Fetched todo item";
        print "  User ID: " + todo.userId;
        print "  ID: " + todo.id;
        print "  Title: " + todo.title;
        print "  Completed: " + todo.completed;
    }
} else {
    print "✗ Failed to fetch todo";
}
print "";

print "=== HTTP Tests Complete ===";
