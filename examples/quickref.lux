// Lux Language Quick Reference
// Runnable syntax examples

print "=== Lux Quick Reference ===";
print "";

// ============================================
// COMMENTS
// ============================================
// Single line comments only
// Block comments not supported

// ============================================
// VARIABLES
// ============================================
print "--- Variables ---";
var x = 10;           // Number
var name = "Alice";   // String
var flag = true;      // Boolean (true/false)
var nothing = nil;    // Nil
print "Created variables: x=" + x + ", name=" + name;
print "";

// ============================================
// OPERATORS
// ============================================
print "--- Operators ---";
// Arithmetic: +, -, *, /
// Comparison: ==, !=, <, >, <=, >=
// Logical: | &, and, or, !

// The + operator is smart:
// Number + Number = Addition
print "10 + 5 = " + (10 + 5);

// String + Anything = Concatenation (auto-converts)
print "Score: " + 42;
print "Level " + 5;
print "Ready: " + true;
print "";

// ============================================
// CONTROL FLOW
// ============================================
print "--- Control Flow ---";

// If statement
if (x > 5) {
    print "x is greater than 5";
} else {
    print "x is not greater than 5";
}

// While loop
var count = 3;
while (count > 0) {
    count = count - 1;
}

// For loop
for (var i = 0; i < 3; i = i + 1) {
    if (i == 1) continue;
    // loop body
}
print "Loops demonstrated";
print "";

// ============================================
// FUNCTIONS
// ============================================
print "--- Functions ---";

fun exampleFunction(param1, param2) {
    return param1 + param2;
}

// Call function
var result = exampleFunction(5, 7);
print "Function result: " + result;
print "";

// ============================================
// CLASSES
// ============================================
print "--- Classes ---";

class ExampleClass {
    // Constructor
    init(param1, param2) {
        this.property1 = param1;
        this.property2 = param2;
    }

    // Method
    getProperty() {
        return this.property1;
    }
}

// Create instance
var obj = ExampleClass("Hello", 42);

// Access properties/methods
obj.property1 = "Updated";
print "Property: " + obj.getProperty();
print "";

// ============================================
// INHERITANCE
// ============================================
print "--- Inheritance ---";

class Parent {
    init(value) {
        this.value = value;
    }
    
    show() {
        print "Parent value: " + this.value;
    }
}

class Child < Parent {
    init(value, extra) {
        super.init(value);
        this.extra = extra;
    }
    
    show() {
        print "Child value: " + this.value + ", extra: " + this.extra;
    }
}

var child = Child(100, "bonus");
child.show();
print "";

// ============================================
// CLOSURES
// ============================================
print "--- Closures ---";

fun outer() {
    var captured = "value";
    
    fun inner() {
        return captured;  // Accesses outer variable
    }
    
    return inner;
}

var closure = outer();
print "Closure result: " + closure();
print "";

// ============================================
// COMMON PATTERNS
// ============================================
print "--- Common Patterns ---";

// 1. Builder pattern with method chaining
class Builder {
    init() {
        this.value = 0;
    }
    
    add(n) {
        this.value = this.value + n;
        return this;  // Return this for chaining
    }
    
    get() {
        return this.value;
    }
}

var builder = Builder();
print "Builder: " + builder.add(5).add(3).get();

// 2. Counter with closure
fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

var counter = makeCounter();
print "Counter: " + counter() + ", " + counter();
print "";

// ============================================
// SYNTAX NOTES
// ============================================
print "--- Syntax Notes ---";

// 1. Arrays are supported with bracket syntax
var arr = [1, 2, 3, 4, 5];
print "Array: " + arr;
print "First element: " + arr[0];
print "Array length: " + arr.length;

// 2. No hash maps built-in
//    Use object properties for key-value storage

// 3. All numbers are doubles (no integer type)

// 4. Strings are immutable
//    The + operator auto-converts types for easy string building

// 5. No modules/imports - all code runs in global scope

// 6. No exception handling - use return values for errors

print "Key Points:";
print "- Arrays support indexing with []";
print "- Use .length property to get array size";
print "- Use + to concatenate any types";
print "- Closures capture outer variables";
print "- Classes support single inheritance";
print "- Method chaining with 'return this'";
print "";

// ============================================
// PERFORMANCE TIPS
// ============================================
print "--- Performance Tips ---";

// 1. NAN_BOXING is enabled by default
//    Provides faster performance
//    Disable in common.h if needed

// 2. Minimize allocations in loops

// 3. Reuse objects when possible

// 4. Use local variables (faster than properties)

print "NAN_BOXING enabled - optimized performance";
print "";

print "=== Quick Reference Complete! ===";
print "Run getting_started.lux, demo.lux, or tutorial.lux for more examples";
