/* Experimental MCP devops assistant.
 *
 *   cd posix && ./lux ../examples/mcp/server.lux
 *
 * Cline (edit cline_mcp_settings.json; the UI may reject http://):
 *   "lux-devops": {
 *     "type": "streamableHttp",
 *     "url": "http://127.0.0.1:8080/mcp"
 *   }
 *
 * ask_devops_assistant tries Bedrock Converse first when a .env in the
 * working directory, the repo root, or examples/ has AWS keys
 * (see examples/env.example). Set bedrock_model there to a foundation
 * model id or an inference-profile ARN. If Bedrock is not configured,
 * or the call returns no text, the same prompt goes to Ollama.
 *
 * Models to try (set OLLAMA_MODEL):
 *   qwen2.5-coder:14b
 *   qwen2.5-coder:32b
 *   qwen3-coder:30b
 *   deepseek-r1:32b
 *   qwen3-coder-next:latest   (79B — often too big)
 *
 * OLLAMA_HOST  default http://10.0.0.22:11434
 * OLLAMA_MODEL default qwen2.5-coder:14b
 * BEDROCK_MODEL default anthropic.claude-sonnet-4-20250514-v1:0
 */

import "../lib/mcp.lux";
import "../lib/swagger.lux";
import "../lib/aws.lux";
import "../examples/mcp/mcp_definition.lux";

var ALLOWED_DOCS = ["devops.md"];

/* getenv() is POSIX-only; Plan 9 has no native. Uncomment on posix/ if you want env overrides.
var OLLAMA_HOST = getenv("OLLAMA_HOST");
var OLLAMA_MODEL = getenv("OLLAMA_MODEL");
*/
var OLLAMA_HOST = "http://10.0.0.22:11434";
var OLLAMA_MODEL = "qwen2.5-coder:14b";
var BEDROCK_MODEL = "anthropic.claude-sonnet-4-20250514-v1:0";
var BEDROCK_MAX_TOKENS = 2048;

class Headers { init() {} }
class BedrockInference {
	init(maxTokens) {
		this.maxTokens = maxTokens;
	}
}

var aws = loadAwsCredentials(nil);
var bedrock = nil;
if (aws != nil) {
	if (aws.bedrockModel != nil and aws.bedrockModel != "") {
		BEDROCK_MODEL = aws.bedrockModel;
	}
	bedrock = BedrockRuntimeClient(aws);
}

class Health { init() {} }

var health = Health();
health.status = "ok";

class Allowed {
	init(allowed_docs, count, note) {
		this.allowed_docs = allowed_docs;
		this.count = count;
		this.note = note;
	}
}

class OMessages {
	init(content) {
		this.role = "user";
		this.content = content;
	}
}

class OModel {
	init(messages, model, stream) {
		this.model = model;
		this.stream = stream;
		this.messages = messages;
	}
}

class Payload { init() {} }

fun firstExisting(paths) {
	var i = 0;
	while (i < paths.length) {
		if (fileExists(paths[i])) {
			return paths[i];
		}
		i = i + 1;
	}
	return nil;
}

fun docPath(name) {
	return firstExisting([
		"examples/mcp/" + name,
		"../examples/mcp/" + name,
		name
	]);
}

fun loadAllowedDocs() {
	var blob = "";
	var i = 0;
	while (i < ALLOWED_DOCS.length) {
		var name = ALLOWED_DOCS[i];
		var path = docPath(name);
		if (path != nil) {
			blob = blob + "\n\n# " + name + "\n" + readFile(path);
		}
		i = i + 1;
	}
	return blob;
}

fun ollamaChat(prompt) {
	var header = Headers();
	header.Content_Type = "application/json";
	var model = OModel([OMessages(prompt)], OLLAMA_MODEL, false);
	var response = httpRequest("POST", OLLAMA_HOST + "/api/chat", toJSON(model), header);
	if (response == nil) {
		return nil;
	}
	var result = parseJSON(response);
	if (result == nil) {
		return nil;
	}
	var msg = getField(result, "message");
	if (msg == nil) {
		return nil;
	}
	return getField(msg, "content");
}

fun bedrockChat(prompt) {
	if (bedrock == nil) {
		return nil;
	}
	var raw = bedrock.converse(
		BEDROCK_MODEL,
		awsBedrockUserMessage(prompt),
		BedrockInference(BEDROCK_MAX_TOKENS)
	);
	var text = awsBedrockConverseText(raw);
	if (text != nil) {
		return text;
	}
	var err = "no text";
	if (raw != nil) {
		var parsed = parseJSON(raw);
		if (parsed != nil) {
			var message = getField(parsed, "message");
			if (message != nil and message != "") {
				err = message;
			}
		}
	}
	print "Bedrock: " + err;
	return nil;
}

fun ollamaPassChat(payload) {
	var header = Headers();
	header.Content_Type = "application/json";
	
	var response = httpRequest("POST", OLLAMA_HOST + "/api/chat", toJSON(payload), header);
	if (response == nil) {
		return nil;
	}

	print "pass res type: " + typeof(response);
	
	var lines = strSplit(response, "\n");
	print "line count: " + lines.length;
	
	var size = lines.length;
	var num = 0;
	
	// Track the stitched content string and the last valid object template
	var combinedContent = "";
	var finalTemplateObj = nil;

	while (num < size) {
		var cleanLine = strTrim(lines[num]);
		
		if (len(cleanLine) > 0) {
			var parsedChunk = parseJSON(cleanLine);
			
			if (parsedChunk != nil) {
				var item = getField(parsedChunk, "model");
				
				if (item != nil) {
					// Keep overwriting this so we capture the structure of the last row
					finalTemplateObj = parsedChunk;
					
					// Safely pull the text block from the nested message object
					var msgObj = getField(parsedChunk, "message");
					if (msgObj != nil) {
						var chunkText = getField(msgObj, "content");
						if (chunkText != nil) {
							// Append the piece to our full answer text string
							combinedContent = combinedContent + chunkText;
						}
					}
				}
			}
		}
		num = num + 1;
	}

	// If we successfully caught the object stream, build the single target layout
	if (finalTemplateObj != nil) {
		// Update the nested message context with our newly consolidated text block
		var targetMessage = getField(finalTemplateObj, "message");
		if (targetMessage != nil) {
			targetMessage.content = combinedContent;
		}
		
		// Return the single completed object instead of the array!
		return finalTemplateObj;
	}
	
	return nil;
}


fun onCall(name, arguments, params) {
	if (name != "ask_devops_assistant") {
		return nil;
	}
	var question = getField(arguments, "question");
	if (question == nil) {
		question = "";
	}
	var docs = loadAllowedDocs();
	var prompt = "You are an internal DevOps assistant. Prefer our Python and FastAPI practices in the documentation over generic advice.\n" +
		docs + "\n\nQuestion:\n" + question;
	var answer = bedrockChat(prompt);
	if (answer != nil) {
		print "assistant: bedrock " + BEDROCK_MODEL;
		return answer;
	}
	answer = ollamaChat(prompt);
	if (answer == nil) {
		if (bedrock != nil) {
			return "Bedrock (" + BEDROCK_MODEL + ") and Ollama at " + OLLAMA_HOST + " (model " + OLLAMA_MODEL + ") did not answer.";
		}
		return "Ollama is not reachable at " + OLLAMA_HOST + " (model " + OLLAMA_MODEL + ").";
	}
	print "assistant: ollama " + OLLAMA_MODEL;
	return answer;
}

fun handleHealth(req, res) {
	res.json(health);
}

fun handleDocs(req, res) {
	var allowed = Allowed(ALLOWED_DOCS, ALLOWED_DOCS.length, "allow-listed markdown next to this server (examples/mcp/)");
	res.json(allowed);
}

fun handleOmodels(req, res) {
	var response = httpGet(OLLAMA_HOST + "/api/tags");
	if (response == nil) {
		res.status(502);
		res.send("{\"error\":\"ollama unreachable\"}");
		return;
	}
	var result = parseJSON(response);
	if (result == nil) {
		res.status(502);
		res.send("{\"error\":\"bad ollama response\"}");
		return;
	}
	res.json(result);
}

fun handleOchat(req, res) {
	var payload = Payload();
	var body = req.body;
	var model = getField(parseJSON(body), "model");
	var msg = getField(parseJSON(body), "messages");

	payload.model = model;
	payload.messages = msg;
	
	var answer = ollamaPassChat(payload);
	// print "answer: " + toJSON(answer); // debug only
	res.json(answer);
	//debug
	/* 
	res.json(toJSON("{\"foo\": \"bar\"}"));
	*/

}

fun handleOtags(req, res) {
	var response = httpRequest("GET", OLLAMA_HOST + "/api/tags", nil, nil);
	var result = strSplit(response, "\r");
	return res.json(parseJSON(result[1]));
}

fun logger(req, res, next) {
	print "Request: " + req.method + " " + req.path;
	next();
}

var server = Server(8080);
server.workers(1);
server.swaggerTitle = "Demo MCP";
server.use(logger);

mcpMount(server, "/mcp", "mcp-devops-assistant", "0.1.0", [definition], onCall);

var healthOp = Op("Health check", "ops");
healthOp.example = parseJSON(health);
server.get("/mcp/health", handleHealth, healthOp);
server.get("/mcp/allowed-docs", handleDocs);
server.get("/models", handleOmodels);
server.post("/api/chat", handleOchat);
server.get("/api/tags", handleOtags); // left off here

swagger(server);

print "MCP devops assistant on http://127.0.0.1:8080/mcp";
if (bedrock != nil) {
	print "  Bedrock model=" + BEDROCK_MODEL + " region=" + aws.region + " (Ollama is the fallback)";
} else {
	print "  Bedrock skipped (no .env credentials)";
}
print "  OLLAMA_HOST=" + OLLAMA_HOST + " model=" + OLLAMA_MODEL;
print "  GET  /mcp/health";
print "  GET  /mcp/allowed-docs";
print "  GET  /models            ollama tags";
print "  POST /api/chat          {\"msg\":\"hello\"}";
print "  GET  /docs              swagger";
server.start();

