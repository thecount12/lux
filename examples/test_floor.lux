// Test floor() native function

print "=== floor() Tests ===";
print "floor(7.9) = " + floor(7.9);     // Should be 7
print "floor(7.1) = " + floor(7.1);     // Should be 7
print "floor(7.0) = " + floor(7.0);     // Should be 7
print "floor(-2.3) = " + floor(-2.3);   // Should be -3
print "floor(-2.0) = " + floor(-2.0);   // Should be -2
print "floor(0) = " + floor(0);         // Should be 0

print "";
print "=== Integer division with floor ===";
print "floor(10/3) = " + floor(10/3);   // Should be 3
print "floor(20/6) = " + floor(20/6);   // Should be 3
print "floor(100/7) = " + floor(100/7); // Should be 14

print "";
print "=== Using in epoch calculation ===";
var testEpoch = 1773041944;
var seconds = testEpoch % 60;
var minutes = floor(testEpoch / 60) % 60;
var hours = floor(testEpoch / 3600) % 24;
var days = floor(testEpoch / 86400);

print "Epoch: " + testEpoch;
print "Seconds: " + seconds + " (should be 4)";
print "Minutes: " + minutes + " (should be 39)";
print "Hours: " + hours + " (should be 7)";
print "Days since 1970: " + days + " (should be 20523)";
