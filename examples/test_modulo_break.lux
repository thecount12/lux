// Test file for modulo operator (%) and break statement

print "=== Modulo Operator Tests ===";
print "10 % 3 = " + (10 % 3);  // Should be 1
print "20 % 6 = " + (20 % 6);  // Should be 2
print "15 % 4 = " + (15 % 4);  // Should be 3
print "100 % 7 = " + (100 % 7);  // Should be 2

print "";
print "=== Break Statement Tests ===";

print "Test 1: Break in while loop";
var i = 0;
while (i < 10) {
    if (i == 5) {
        print "Breaking at i = " + i;
        break;
    }
    print "i = " + i;
    i = i + 1;
}

print "";
print "Test 2: Break in for loop";
for (var j = 0; j < 10; j = j + 1) {
    if (j == 3) {
        print "Breaking at j = " + j;
        break;
    }
    print "j = " + j;
}

print "";
print "Test 3: Modulo in loop";
for (var k = 1; k <= 20; k = k + 1) {
    if (k % 5 == 0) {
        print k + " is divisible by 5";
    }
}

print "";
print "=== All tests completed ===";
