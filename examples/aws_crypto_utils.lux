// AWS Cryptographic Utilities - Low-level signing examples
// Shows how to use sha256, hmacSha256, and awsSignRequest

print "=== AWS Cryptographic Utilities Demo ===\n";

class Dict {
    init() {}
}

fun attrS(value) {
    var attr = Dict();
    attr.S = value;
    return attr;
}

// ===== 1. SHA256 Hashing =====
print "1. SHA256 Hash Examples:";
print "   sha256('') = " + sha256("");
print "   sha256('hello') = " + sha256("hello");
print "   sha256('Hello, World!') = " + sha256("Hello, World!");

var jsonPayloadObj = Dict();
jsonPayloadObj.message = "test";
var jsonPayload = toJSON(jsonPayloadObj);
print "   sha256(JSON payload) = " + sha256(jsonPayload);

// ===== 2. HMAC-SHA256 =====
print "\n2. HMAC-SHA256 Examples:";
print "   hmacSha256('key', 'message') = " + hmacSha256("key", "message");
print "   hmacSha256('secret', 'data') = " + hmacSha256("secret", "data");

// AWS uses HMAC chaining for signature derivation
var kSecret = "AWS4" + "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
var kDate = hmacSha256(kSecret, "20240307");
print "   AWS kDate = " + kDate;

// ===== 3. Full AWS Signature V4 =====
print "\n3. AWS Signature V4 Generation:";

var method = "GET";
var host = "my-bucket.s3.us-east-1.amazonaws.com";
var uri = "/";
var queryString = "list-type=2";
var payloadHash = sha256("");  // Empty for GET
var accessKey = "AKIAIOSFODNN7EXAMPLE";
var secretKey = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
var region = "us-east-1";
var service = "s3";
var amzDate = "20240307T120000Z";
var dateStamp = "20240307";

var authHeader = awsSignRequest(
    method,
    host,
    uri,
    queryString,
    payloadHash,
    accessKey,
    secretKey,
    region,
    service,
    amzDate,
    dateStamp,
    nil  // No session token
);

print "   Method: " + method;
print "   Host: " + host;
print "   URI: " + uri;
print "   Query: " + queryString;
print "   PayloadHash: " + payloadHash;
print "   Authorization: " + authHeader;

// ===== 4. Signature with Session Token (temporary credentials) =====
print "\n4. Signature with Session Token:";

var sessionToken = "FwoGZXIvYXdzEBYaDH...exampletoken...";

var authHeaderWithToken = awsSignRequest(
    method,
    host,
    uri,
    queryString,
    payloadHash,
    accessKey,
    secretKey,
    region,
    service,
    amzDate,
    dateStamp,
    sessionToken
);

print "   Authorization (with token): " + authHeaderWithToken;
print "   Note: Also send 'x-amz-security-token: " + sessionToken + "'";

// ===== 5. POST Request with Body =====
print "\n5. POST Request Signature (with body):";

var postBodyObj = Dict();
postBodyObj.action = "create";
postBodyObj.data = "example";
var postBody = toJSON(postBodyObj);
var postPayloadHash = sha256(postBody);

var postAuth = awsSignRequest(
    "POST",
    host,
    "/action",
    "",  // No query string
    postPayloadHash,
    accessKey,
    secretKey,
    region,
    service,
    amzDate,
    dateStamp,
    nil
);

print "   POST Body: " + postBody;
print "   Body Hash: " + postPayloadHash;
print "   Authorization: " + postAuth;

// ===== 6. DynamoDB Example =====
print "\n6. DynamoDB API Signature:";

var dynamoKey = Dict();
dynamoKey.id = attrS("user123");
var dynamoPayloadObj = Dict();
dynamoPayloadObj.TableName = "Users";
dynamoPayloadObj.Key = dynamoKey;
var dynamoPayload = toJSON(dynamoPayloadObj);

var dynamoPayloadHash = sha256(dynamoPayload);
var dynamoHost = "dynamodb.us-east-1.amazonaws.com";

var dynamoAuth = awsSignRequest(
    "POST",
    dynamoHost,
    "/",
    "",
    dynamoPayloadHash,
    accessKey,
    secretKey,
    "us-east-1",
    "dynamodb",
    amzDate,
    dateStamp,
    nil
);

print "   Service: dynamodb";
print "   Payload: " + dynamoPayload;
print "   Authorization: " + dynamoAuth;
print "   Also send: x-amz-target: DynamoDB_20120810.GetItem";

print "\n=== Complete! ===";
print "\nKey Points:";
print "- sha256() returns hex-encoded hash of input";
print "- hmacSha256() returns hex-encoded HMAC of input";
print "- awsSignRequest() returns the Authorization header value";
print "- All three functions are now available as native Lux functions";
