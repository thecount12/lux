// Example: Using AWS credentials to make custom AWS API calls from Lux
// This shows how to call S3 (or any AWS service) without using the built-in s3* functions

// AWS Configuration
var bucket = "my-bucket";
var accessKey = "AKIAIOSFODNN7EXAMPLE";
var secretKey = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
var region = "us-east-1";
var sessionToken = nil;  // Optional, for temporary credentials

// Get current UTC timestamp in AWS format
fun getAwsTimestamp() {
    // In production, you'd get actual UTC time
    // For now, hardcode example: "20240307T123045Z"
    return "20240307T123045Z";
}

fun getAwsDateStamp() {
    // Extract date from timestamp: "20240307"
    return "20240307";
}

// Example 1: Custom S3 ListObjects request
fun listS3Objects(bucket, prefix) {
    var amzDate = getAwsTimestamp();
    var dateStamp = getAwsDateStamp();
    
    var host = bucket + ".s3." + region + ".amazonaws.com";
    var uri = "/";
    var queryString = "list-type=2&prefix=" + prefix;
    
    // Hash empty payload for GET request
    var payloadHash = sha256("");
    
    // Create AWS Signature V4
    var authHeader = awsSignRequest(
        "GET",           // method
        host,            // host
        uri,             // uri
        queryString,     // queryString
        payloadHash,     // payloadHash
        accessKey,       // accessKey
        secretKey,       // secretKey
        region,          // region
        "s3",            // service
        amzDate,         // amzDate
        dateStamp,       // dateStamp
        sessionToken     // sessionToken (nil = not included)
    );
    
    // Build full URL
    var url = "https://" + host + "/?" + queryString;
    
    // Make HTTP request (manual approach since httpGet doesn't support custom headers)
    print "URL: " + url;
    print "Authorization: " + authHeader;
    print "x-amz-date: " + amzDate;
    print "x-amz-content-sha256: " + payloadHash;
    
    // Note: You would need to extend httpGet to accept custom headers, or use httpPost
    // with a custom HTTP client that supports full header control
    
    return authHeader;
}

// Example 2: DynamoDB GetItem (JSON protocol)
fun dynamoGetItem(tableName, key) {
    var amzDate = getAwsTimestamp();
    var dateStamp = getAwsDateStamp();
    
    var host = "dynamodb." + region + ".amazonaws.com";
    var uri = "/";
    var queryString = "";
    
    // Build JSON payload
    var payload = toJSON({
        "TableName": tableName,
        "Key": key
    });
    
    // Hash the payload
    var payloadHash = sha256(payload);
    
    // Create AWS Signature V4
    var authHeader = awsSignRequest(
        "POST",          // method
        host,            // host
        uri,             // uri
        queryString,     // queryString (empty for POST)
        payloadHash,     // payloadHash
        accessKey,       // accessKey
        secretKey,       // secretKey
        region,          // region
        "dynamodb",      // service
        amzDate,         // amzDate
        dateStamp,       // dateStamp
        sessionToken     // sessionToken
    );
    
    var url = "https://" + host + "/";
    
    print "DynamoDB Request:";
    print "URL: " + url;
    print "Authorization: " + authHeader;
    print "x-amz-date: " + amzDate;
    print "x-amz-target: DynamoDB_20120810.GetItem";
    print "Payload: " + payload;
    
    return authHeader;
}

// Example 3: Calculate signature components independently
fun demonstrateCrypto() {
    print "\n=== Crypto Utilities ===";
    
    var data = "Hello, World!";
    var hash = sha256(data);
    print "SHA256('" + data + "') = " + hash;
    
    var key = "secret";
    var hmac = hmacSha256(key, data);
    print "HMAC-SHA256(key='" + key + "', data='" + data + "') = " + hmac;
    
    // Empty payload hash (common for GET requests)
    var emptyHash = sha256("");
    print "SHA256('') = " + emptyHash;
}

// Run examples
print "=== AWS Custom API Examples ===\n";

// Example with S3
print "Example 1: S3 ListObjects";
listS3Objects(bucket, "documents/");

print "\n";

// Example with DynamoDB
print "Example 2: DynamoDB GetItem";
dynamoGetItem("Users", {"id": {"S": "user123"}});

print "\n";

// Crypto utilities demo
demonstrateCrypto();

print "\n=== Complete! ===";
print "Note: To actually make requests, you need to extend httpGet/httpPost";
print "to accept custom headers (Authorization, x-amz-date, etc.)";
