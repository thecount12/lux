// Custom AWS API calls from Lux without the built-in s3* natives.
// Uses native getAwsTimestamp() (do not redefine it — it returns
// {amzDate, dateStamp}, not a string) and httpRequest() for the real call.
//
// Credentials: paste STS Option 2 into .env (see examples/config.lux).
// Run from posix/ or examples/:
//   ./lux ../examples/aws_custom_api.lux
//   ./lux ../examples/aws_custom_api.lux my-bucket documents/

import "../lib/aws.lux";
import "../examples/config.lux";

class Headers {
    init() {}
}

fun signedHeaders(method, host, uri, queryString, payload) {
    var timestamp = getAwsTimestamp();
    var amzDate = timestamp.amzDate;
    var dateStamp = timestamp.dateStamp;
    var payloadHash = sha256(payload);
    var authHeader = awsSignRequest(
        method,
        host,
        uri,
        queryString,
        payloadHash,
        accessKey,
        secretKey,
        region,
        "s3",
        amzDate,
        dateStamp,
        sessionToken
    );

    var headers = Headers();
    headers.Authorization = authHeader;
    headers.x_amz_date = amzDate;
    headers.x_amz_content_sha256 = payloadHash;
    if (sessionToken != nil and sessionToken != "") {
        headers.x_amz_security_token = sessionToken;
    }
    return headers;
}

fun listS3Objects(bucketName, prefix) {
    var host = bucketName + ".s3." + region + ".amazonaws.com";
    var uri = "/";
    var queryString = "list-type=2";
    if (prefix != nil and prefix != "") {
        queryString = queryString + "&prefix=" + awsFormEncode(prefix);
    }

    var headers = signedHeaders("GET", host, uri, queryString, "");
    var url = "https://" + host + "/?" + queryString;
    print "GET " + url;
    return httpRequest("GET", url, nil, headers);
}

fun dynamoGetItem(tableName, key) {
    var host = "dynamodb." + region + ".amazonaws.com";
    var requestPayload = Dict();
    requestPayload.TableName = tableName;
    requestPayload.Key = key;
    var payload = toJSON(requestPayload);
    var payloadHash = sha256(payload);

    var timestamp = getAwsTimestamp();
    var amzDate = timestamp.amzDate;
    var dateStamp = timestamp.dateStamp;
    var authHeader = awsSignRequest(
        "POST",
        host,
        "/",
        "",
        payloadHash,
        accessKey,
        secretKey,
        region,
        "dynamodb",
        amzDate,
        dateStamp,
        sessionToken
    );

    var headers = Headers();
    headers.Authorization = authHeader;
    headers.x_amz_date = amzDate;
    headers.x_amz_content_sha256 = payloadHash;
    headers.X_Amz_Target = "DynamoDB_20120810.GetItem";
    headers.Content_Type = "application/x-amz-json-1.0";
    if (sessionToken != nil and sessionToken != "") {
        headers.x_amz_security_token = sessionToken;
    }

    var url = "https://" + host + "/";
    print "POST " + url + "  target=DynamoDB_20120810.GetItem";
    return httpRequest("POST", url, payload, headers);
}

fun demonstrateCrypto() {
    print "=== Crypto utilities ===";
    var data = "Hello, World!";
    print "SHA256('" + data + "') = " + sha256(data);
    print "HMAC-SHA256('secret', '" + data + "') = " + hmacSha256("secret", data);
    print "SHA256('') = " + sha256("");
}

fun printBody(label, body) {
    if (body == nil) {
        print label + ": request failed (nil)";
        return;
    }
    var shown = body;
    if (len(shown) > 800) {
        shown = strSlice(shown, 0, 800) + "...";
    }
    print label + ":";
    print shown;
}

print "=== AWS Custom API Examples ===";
demonstrateCrypto();
print "";

if (accessKey == nil) {
    print "No credentials loaded.";
    print "Copy examples/env.example to .env and paste STS keys, then re-run.";
} else {
    var argv = args();
    var bucketName = bucket;
    var prefix = "documents/";
    if (argv.length > 0) {
        bucketName = argv[0];
    }
    if (argv.length > 1) {
        prefix = argv[1];
    }

    print "Using access key " + strSlice(accessKey, 0, 8) + "... region=" + region;
    print "";
    print "Example 1: S3 ListObjects";
    var listed = listS3Objects(bucketName, prefix);
    printBody("S3", listed);

    print "";
    print "Example 2: DynamoDB GetItem";
    var item = dynamoGetItem("Users", makeKey("user123"));
    printBody("DynamoDB", item);
}

print "";
print "=== Complete ===";
