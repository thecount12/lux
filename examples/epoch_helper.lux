// epoch_helper.lux - Epoch timestamp conversion utilities
//
// Demonstrates epoch() native function and UTC datetime conversions

// --- current time ---
var nowEpoch = epoch();
var utcNow = getAwsTimestamp();

print "=== Epoch Helper Examples ===";
print "nowEpoch: " + nowEpoch;
print "utc amzDate: " + utcNow.amzDate;
print "utc dateStamp: " + utcNow.dateStamp;

fun secondsToMinutes(seconds) {
    return seconds / 60;
}

fun secondsToHours(seconds) {
    return seconds / 3600;
}

fun secondsToDays(seconds) {
    return seconds / 86400;
}

fun minutesToSeconds(minutes) {
    return minutes * 60;
}

fun hoursToSeconds(hours) {
    return hours * 3600;
}

fun daysToSeconds(days) {
    return days * 86400;
}

fun toMilliseconds(epochSeconds) {
    return epochSeconds * 1000;
}

// --- epoch to UTC date/time conversion ---

class DateTime {
    init(year, month, day, hour, minute, second) {
        this.year = year;
        this.month = month;
        this.day = day;
        this.hour = hour;
        this.minute = minute;
        this.second = second;
    }
}

fun isLeapYear(year) {
    if (year % 400 == 0) return true;
    if (year % 100 == 0) return false;
    if (year % 4 == 0) return true;
    return false;
}

fun daysInMonth(month, year) {
    if (month == 1 or month == 3 or month == 5 or month == 7 or 
        month == 8 or month == 10 or month == 12) return 31;
    if (month == 4 or month == 6 or month == 9 or month == 11) return 30;
    if (month == 2) {
        if (isLeapYear(year)) return 29;
        return 28;
    }
    return 0;
}

fun epochToDateTime(epochSeconds) {
    var seconds = epochSeconds % 60;
    var minutes = floor(epochSeconds / 60) % 60;
    var hours = floor(epochSeconds / 3600) % 24;
    var days = floor(epochSeconds / 86400);
    
    var year = 1970;
    var daysRemaining = days;
    
    // Calculate year
    var daysInYear = 365;
    if (isLeapYear(year)) daysInYear = 366;
    
    while (daysRemaining >= daysInYear) {
        daysRemaining = daysRemaining - daysInYear;
        year = year + 1;
        daysInYear = 365;
        if (isLeapYear(year)) daysInYear = 366;
    }
    
    // Calculate month and day
    var month = 1;
    var dim = daysInMonth(month, year);
    while (daysRemaining >= dim and month <= 12) {
        daysRemaining = daysRemaining - dim;
        month = month + 1;
        if (month <= 12) {
            dim = daysInMonth(month, year);
        }
    }
    
    var day = daysRemaining + 1;
    
    return DateTime(year, month, day, hours, minutes, seconds);
}

fun formatDateTime(dt) {
    var monthStr = "" + dt.month;
    if (dt.month < 10) monthStr = "0" + monthStr;
    
    var dayStr = "" + dt.day;
    if (dt.day < 10) dayStr = "0" + dayStr;
    
    var hourStr = "" + dt.hour;
    if (dt.hour < 10) hourStr = "0" + hourStr;
    
    var minStr = "" + dt.minute;
    if (dt.minute < 10) minStr = "0" + minStr;
    
    var secStr = "" + dt.second;
    if (dt.second < 10) secStr = "0" + secStr;
    
    return "" + dt.year + "-" + monthStr + "-" + dayStr + " " + 
           hourStr + ":" + minStr + ":" + secStr + " UTC";
}

// --- TTL / expiration helpers ---

fun addMinutes(epochSeconds, minutes) {
    return epochSeconds + minutesToSeconds(minutes);
}

fun addHours(epochSeconds, hours) {
    return epochSeconds + hoursToSeconds(hours);
}

fun hasExpired(nowEpochSeconds, expiresAtEpochSeconds) {
    return nowEpochSeconds >= expiresAtEpochSeconds;
}

// --- demonstration ---

print "--- conversions ---";
print "secondsToMinutes(360): " + secondsToMinutes(360);
print "secondsToHours(7200): " + secondsToHours(7200);
print "secondsToDays(172800): " + secondsToDays(172800);
print "minutesToSeconds(15): " + minutesToSeconds(15);
print "hoursToSeconds(2): " + hoursToSeconds(2);
print "daysToSeconds(3): " + daysToSeconds(3);

print "--- ttl / expiration math ---";
var expiresInMinutes = 15;
var expiresAt = addMinutes(nowEpoch, expiresInMinutes);
print "expiresAt epoch: " + expiresAt;
print "ttl seconds: " + (expiresAt - nowEpoch);
print "hasExpired(now, expiresAt): " + hasExpired(nowEpoch, expiresAt);

print "--- other helpers ---";
print "epoch milliseconds: " + toMilliseconds(nowEpoch);
print "one hour from now: " + addHours(nowEpoch, 1);

print "--- epoch to date/time ---";
var dt = epochToDateTime(nowEpoch);
print "year: " + dt.year;
print "month: " + dt.month;
print "day: " + dt.day;
print "hour: " + dt.hour;
print "minute: " + dt.minute;
print "second: " + dt.second;
print "formatted: " + formatDateTime(dt);

print "--- example: epoch 1773041944 ---";
var exampleDt = epochToDateTime(1773041944);
print formatDateTime(exampleDt);
