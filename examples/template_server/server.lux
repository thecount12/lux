/* Template server — isolated from examples/static (JS static files).
 *
 * Run from this directory:
 *   cd examples/template_server && ../../posix/lux server.lux
 *   Plan 9: ../../8.out server.lux
 *
 *   curl http://127.0.0.1:8083/
 *   curl http://127.0.0.1:8083/list
 */

import "template.lux";

fun handleRoot(req, res) {
  var ctx = TplCtx("Lux Template Example", ["One", "Two", "Three"]);
  /* Render first, then send — nested res.html(renderTemplate(...))
   * can clobber the method receiver on Plan 9 after heavy GC. */
  var html = renderTemplate("templates/index.tpl", ctx);
  res.html(html);
}

fun handleList(req, res) {
  var ctx = TplCtx("Lux Template List", ["Apple", "Banana", "Cherry", "Date"]);
  var html = renderTemplate("templates/index.tpl", ctx);
  res.html(html);
}

var server = Server(8083);
server.get("/", handleRoot);
server.get("/list", handleList);
print "Starting template server on http://localhost:8083/";
print "Run from examples/template_server so templates/ resolves.";
server.start();
