/* Shared template renderer — import from your server script.
 *
 *   import "template.lux";
 *   var ctx = TplCtx("Title", ["a", "b"]);
 *   var html = renderTemplate("public/index.tpl", ctx);
 *   res.html(html);
 *
 * Notes for Plan 9:
 *   - Declare loop locals at function scope (no var inside while bodies).
 *   - Lux has no `continue` keyword.
 *   - Flatten nested calls; avoid res.html(renderTemplate(...)).
 *   - Dict is string→string only; use TplCtx for arrays.
 */

fun escapeHtml(s) {
  if (s == nil) return "";
  var out = s + "";
  var parts = strSplit(out, "&");
  var i = 0;
  var n = parts.length;
  out = "";
  while (i < n) {
    if (i > 0) out = out + "&amp;";
    out = out + parts[i];
    i = i + 1;
  }
  parts = strSplit(out, "<");
  i = 0;
  n = parts.length;
  out = "";
  while (i < n) {
    if (i > 0) out = out + "&lt;";
    out = out + parts[i];
    i = i + 1;
  }
  parts = strSplit(out, ">");
  i = 0;
  n = parts.length;
  out = "";
  while (i < n) {
    if (i > 0) out = out + "&gt;";
    out = out + parts[i];
    i = i + 1;
  }
  parts = strSplit(out, "\"");
  i = 0;
  n = parts.length;
  out = "";
  while (i < n) {
    if (i > 0) out = out + "&quot;";
    out = out + parts[i];
    i = i + 1;
  }
  parts = strSplit(out, "'");
  i = 0;
  n = parts.length;
  out = "";
  while (i < n) {
    if (i > 0) out = out + "&#39;";
    out = out + parts[i];
    i = i + 1;
  }
  return out;
}

fun lookup(ctx, key) {
  if (key == nil) return nil;
  key = strTrim(key + "");
  if (key == "title") return ctx.title;
  if (key == "items") return ctx.items;
  return nil;
}

fun lastIndexOf(text, needle) {
  var last = -1;
  var cursor = 0;
  var idx = 0;
  while (true) {
    idx = strFind(text, needle, cursor);
    if (idx == -1) break;
    last = idx;
    cursor = idx + 1;
  }
  return last;
}

fun replaceLoopVar(src, varName, elem) {
  var out = "";
  var cursor = 0;
  var openIdx = 0;
  var closeIdx = 0;
  var key = "";
  var n = len(src);
  while (cursor < n) {
    openIdx = strFind(src, "{{", cursor);
    if (openIdx == -1) {
      out = out + strSlice(src, cursor, n);
      cursor = n;
    } else {
      out = out + strSlice(src, cursor, openIdx);
      closeIdx = strFind(src, "}}", openIdx + 2);
      if (closeIdx == -1) {
        out = out + strSlice(src, openIdx, n);
        cursor = n;
      } else {
        key = strTrim(strSlice(src, openIdx + 2, closeIdx));
        if (key == varName) {
          out = out + escapeHtml(elem + "");
        } else {
          out = out + strSlice(src, openIdx, closeIdx + 2);
        }
        cursor = closeIdx + 2;
      }
    }
  }
  return out;
}

fun interpolateString(src, ctx) {
  var out = "";
  var cursor = 0;
  var openIdx = 0;
  var closeIdx = 0;
  var key = "";
  var val = nil;
  var n = len(src);
  while (cursor < n) {
    openIdx = strFind(src, "{{", cursor);
    if (openIdx == -1) {
      out = out + strSlice(src, cursor, n);
      cursor = n;
    } else {
      out = out + strSlice(src, cursor, openIdx);
      closeIdx = strFind(src, "}}", openIdx + 2);
      if (closeIdx == -1) {
        out = out + strSlice(src, openIdx, n);
        cursor = n;
      } else {
        key = strTrim(strSlice(src, openIdx + 2, closeIdx));
        val = lookup(ctx, key);
        if (val == nil) {
          out = out + "";
        } else {
          out = out + escapeHtml(val + "");
        }
        cursor = closeIdx + 2;
      }
    }
  }
  return out;
}

fun expandIncludes(path) {
  var src = readFile(path);
  if (src == nil) {
    return "Template not found: " + path;
  }
  var cursor = 0;
  var incStart = 0;
  var quoteStart = 0;
  var quoteEnd = 0;
  var incPath = "";
  var slashIdx = 0;
  var base = "";
  var fullInc = "";
  var incContent = "";
  var tagEnd = 0;
  while (true) {
    incStart = strFind(src, "{% include \"", cursor);
    if (incStart == -1) break;
    quoteStart = incStart + len("{% include \"");
    quoteEnd = strFind(src, "\"", quoteStart);
    if (quoteEnd == -1) break;
    incPath = strSlice(src, quoteStart, quoteEnd);
    slashIdx = lastIndexOf(path, "/");
    base = "";
    if (slashIdx != -1) {
      base = strSlice(path, 0, slashIdx + 1);
    }
    fullInc = base + incPath;
    incContent = expandIncludes(fullInc);
    tagEnd = strFind(src, "%}", quoteEnd);
    if (tagEnd == -1) break;
    tagEnd = tagEnd + len("%}");
    src = strSlice(src, 0, incStart) + incContent + strSlice(src, tagEnd, len(src));
    cursor = incStart + len(incContent);
  }
  return src;
}

fun renderItemList(inner, varName, items, ctx) {
  var out = "";
  var j = 0;
  var n = len(items);
  var elem = nil;
  var replaced = "";
  var piece = "";
  while (j < n) {
    elem = items[j];
    replaced = replaceLoopVar(inner, varName, elem);
    piece = interpolateString(replaced, ctx);
    out = out + piece;
    j = j + 1;
  }
  return out;
}

fun renderFors(outSrc, ctx) {
  var cursor = 0;
  var forStart = 0;
  var forTagEnd = 0;
  var forExpr = "";
  var inIdx = 0;
  var varName = "";
  var iterableKey = "";
  var endTag = 0;
  var inner = "";
  var items = nil;
  var rendered = "";
  while (true) {
    forStart = strFind(outSrc, "{% for ", cursor);
    if (forStart == -1) break;
    forTagEnd = strFind(outSrc, "%}", forStart);
    if (forTagEnd == -1) break;
    forExpr = strSlice(outSrc, forStart + len("{% for "), forTagEnd);
    inIdx = strFind(forExpr, " in ");
    if (inIdx == -1) {
      cursor = forTagEnd + 2;
    } else {
      varName = strTrim(strSlice(forExpr, 0, inIdx));
      iterableKey = strTrim(strSlice(forExpr, inIdx + len(" in "), len(forExpr)));
      endTag = strFind(outSrc, "{% endfor %}", forTagEnd);
      if (endTag == -1) break;
      inner = strSlice(outSrc, forTagEnd + len("%}"), endTag);
      items = lookup(ctx, iterableKey);
      rendered = "";
      if (items != nil) {
        rendered = renderItemList(inner, varName, items, ctx);
      }
      outSrc = strSlice(outSrc, 0, forStart) + rendered +
               strSlice(outSrc, endTag + len("{% endfor %}"), len(outSrc));
      cursor = forStart + len(rendered);
    }
  }
  return outSrc;
}

fun renderTemplate(path, ctx) {
  var src = expandIncludes(path);
  src = renderFors(src, ctx);
  return interpolateString(src, ctx);
}

class TplCtx {
  init(title, items) {
    this.title = title;
    this.items = items;
  }
}
