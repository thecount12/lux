// Pattern 4: Configuration from Parameter Store/Secrets Manager
print "Example 4: Configuration Pattern";
class Config {
    init() {
        // In real AWS integration:
        // var params = awsGetParameter("/myapp/config");
        // Load and parse configuration
        
        // For now, from local file with fallback
        if (fileExists("config.json")) {
            var configData = readFile("config.json");
            if (configData != nil) {
                var cfg = parseJSON(configData);
                if (cfg != nil) {
                    this.apiKey = cfg.apiKey;
                    this.region = cfg.region;
                    this.debug = cfg.debug;
                } else {
                    this.apiKey = "default_key";
                    this.region = "us-east-1";
                    this.debug = false;
                }
            }
        } else {
            this.apiKey = "default_key";
            this.region = "us-east-1";
            this.debug = false;
        }
    }
    
    display() {
        print "Configuration:";
        print "  API Key: " + this.apiKey;
        print "  Region: " + this.region;
        print "  Debug: " + this.debug;
    }
}

var config = Config();
config.display();
print "";

// Pattern 5: Process and upload results
print "Example 5: Process & Upload Pattern";
class ProcessingResult {
    init(status, recordsProcessed, errors) {
        this.status = status;
        this.recordsProcessed = recordsProcessed;
        this.errors = errors;
        this.timestamp = 1234567890; // clock() in real code
    }
}

var result = ProcessingResult("success", 150, 0);
var resultJson = toJSON(result);

if (resultJson != nil) {
    // Save locally first
    if (writeFile("results.json", resultJson)) {
        print "✓ Results saved locally";
    }
    
    // In real AWS integration:
    // var uploadResult = awsPutObject("results-bucket", "result-" + timestamp + ".json", resultJson);
    // or
    // var apiResult = httpPut("https://api.../results/123", resultJson);
    
    print "→ Would upload to S3 or send to API";
}
print "";

