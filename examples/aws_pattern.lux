// AWS Integration Pattern Example
// Demonstrates HTTPS client for AWS service calls with TLS support
// Both Plan 9 (libsec) and POSIX (libcurl) support HTTPS

print "=== AWS Integration Pattern with HTTPS ===";
print "";
print "Lux now supports HTTPS on both Plan 9 and POSIX platforms";
print "This enables direct integration with AWS services";
print "";

// Pattern 1: Invoke API Gateway endpoint
print "Example 1: API Gateway Pattern";
class APIRequest {
    init(action, userId, data) {
        this.action = action;
        this.userId = userId;
        this.data = data;
    }
}

var request = APIRequest("create_user", 123, "sample_data");
var jsonPayload = toJSON(request);

if (jsonPayload != nil) {
    print "Request payload: " + jsonPayload;
    print "→ Can now POST to HTTPS API Gateway endpoints";
    // Example with real endpoint:
    // var response = httpPost("https://your-api.execute-api.us-east-1.amazonaws.com/prod/users", jsonPayload);
    // if (response != nil) {
    //     print "✓ API Gateway call successful";
    //     var result = parseJSON(response);
    // }
}
print "";

// Pattern 2: Webhook/Lambda trigger
print "Example 2: Webhook/Lambda Trigger Pattern";
class WebhookPayload {
    init(event, timestamp, data) {
        this.event = event;
        this.timestamp = timestamp;
        this.data = data;
    }
}

var webhook = WebhookPayload("user.created", 1234567890, "event data");
var webhookJson = toJSON(webhook);

if (webhookJson != nil) {
    print "Webhook payload: " + webhookJson;
    print "→ Can now trigger Lambda via HTTPS";
    // Example with real Lambda URL:
    // var result = httpPost("https://your-lambda-url.lambda-url.us-east-1.on.aws/", webhookJson);
    // if (result != nil) {
    //     print "✓ Lambda invoked successfully";
    // }
}
print "";

