// Pull ECS CPU and memory from CloudWatch (AWS/ECS) and write a CSV.
// Prints a sample of rows, then writes the full file.
//
// Usage (from posix/ or examples/, with .env credentials):
//   ./lux ../examples/aws_ecs_metrics.lux my-cluster my-service
//   ./lux ../examples/aws_ecs_metrics.lux my-cluster - 24 ecs-cpu-mem.csv
//
// Args: cluster  service-or-dash  [hours=6]  [outfile=ecs-cpu-memory.csv]
// Service "-" means cluster-wide metrics (ClusterName only).
// Values are Average at Period=300s.
// Tries ECS/ContainerInsights TaskCpuUtilization first (Fargate), then AWS/ECS CPUUtilization.

import "../lib/aws.lux";
import "../examples/config.lux";

fun csvCell(value) {
    var text = "";
    if (value != nil) {
        text = "" + value;
    }
    if (strFind(text, ",") >= 0 or strFind(text, "\"") >= 0) {
        var out = "\"";
        var i = 0;
        while (i < len(text)) {
            if (text[i] == "\"") {
                out = out + "\"\"";
            } else {
                out = out + text[i];
            }
            i = i + 1;
        }
        return out + "\"";
    }
    return text;
}

fun valueAt(series, timestamp) {
    if (series == nil) {
        return "";
    }
    var idx = arrayIndexOf(series.timestamps, timestamp);
    if (idx < 0) {
        return "";
    }
    return series.values[idx];
}

fun collectTimestamps(cpu, mem) {
    var stamps = [];
    var i = 0;
    while (cpu != nil and i < cpu.timestamps.length) {
        var ts = cpu.timestamps[i];
        if (!arrayContains(stamps, ts)) {
            stamps = stamps + [ts];
        }
        i = i + 1;
    }
    i = 0;
    while (mem != nil and i < mem.timestamps.length) {
        var ts = mem.timestamps[i];
        if (!arrayContains(stamps, ts)) {
            stamps = stamps + [ts];
        }
        i = i + 1;
    }
    arraySort(stamps);
    return stamps;
}

fun buildCsv(stamps, cpu, mem, clusterName, serviceName) {
    var header = "timestamp,region,cluster,service,cpu_average,memory_average";
    var csv = header + "\n";
    var i = 0;
    while (i < stamps.length) {
        var ts = stamps[i];
        csv = csv + csvCell(ts) + "," + csvCell(region) + "," +
            csvCell(clusterName) + "," + csvCell(serviceName) + "," +
            csvCell(valueAt(cpu, ts)) + "," + csvCell(valueAt(mem, ts)) + "\n";
        i = i + 1;
    }
    return csv;
}

fun printSample(stamps, cpu, mem, clusterName, serviceName, limit) {
    print "timestamp,region,cluster,service,cpu_average,memory_average";
    var n = stamps.length;
    if (n > limit) {
        n = limit;
    }
    var i = 0;
    while (i < n) {
        var ts = stamps[i];
        print csvCell(ts) + "," + csvCell(region) + "," +
            csvCell(clusterName) + "," + csvCell(serviceName) + "," +
            csvCell(valueAt(cpu, ts)) + "," + csvCell(valueAt(mem, ts));
        i = i + 1;
    }
    if (stamps.length > limit) {
        print "... " + (stamps.length - limit) + " more rows";
    }
}

if (accessKey == nil) {
    print "No credentials loaded. Copy examples/env.example to .env and paste STS keys.";
} else {
    var argv = args();
    if (argv.length < 1) {
        print "Usage: aws_ecs_metrics.lux CLUSTER [SERVICE|-] [hours] [outfile.csv]";
        print "Example: ./lux ../examples/aws_ecs_metrics.lux my-cluster my-service 6";
    } else {
        var clusterName = argv[0];
        var serviceName = "";
        var hours = 6;
        var outfile = "ecs-cpu-memory.csv";
        if (argv.length > 1 and argv[1] != "-") {
            serviceName = argv[1];
        }
        if (argv.length > 2) {
            var parsedHours = parseJSON(argv[2]);
            if (parsedHours != nil) {
                hours = parsedHours;
            }
        }
        if (argv.length > 3) {
            outfile = argv[3];
        }

        var now = epoch();
        var startIso = awsIsoUtc(now - hours * 3600);
        var endIso = awsIsoUtc(now);
        var period = 300;
        var dims = [awsDim("ClusterName", clusterName)];
        if (serviceName != "") {
            dims = dims + [awsDim("ServiceName", serviceName)];
        }

        var label = clusterName;
        if (serviceName != "") {
            label = label + "/" + serviceName;
        }
        print "ECS CloudWatch AWS/ECS  cluster=" + label + "  region=" + region;
        print "window " + startIso + " .. " + endIso + "  period=" + period + "s";

        var cw = CloudWatchClient(aws);

        fun pull(namespace, cpuName, memName) {
            var result = Dict();
            result.namespace = namespace;
            result.cpuName = cpuName;
            result.memName = memName;
            result.cpuXml = cw.getMetricStatistics(namespace, cpuName, dims, period, "Average", startIso, endIso);
            result.memXml = cw.getMetricStatistics(namespace, memName, dims, period, "Average", startIso, endIso);
            result.cpu = cw.parseSeries(result.cpuXml, "Average");
            result.mem = cw.parseSeries(result.memXml, "Average");
            result.stamps = collectTimestamps(result.cpu, result.mem);
            return result;
        }

        fun dumpXml(label, xml) {
            if (xml == nil) {
                print label + ": nil";
                return;
            }
            var shown = xml;
            if (len(shown) > 500) {
                shown = strSlice(shown, 0, 500) + "...";
            }
            print label + ": " + shown;
        }

        // Fargate Container Insights often uses TaskCpuUtilization, not AWS/ECS CPUUtilization.
        var tries = [
            ["ECS/ContainerInsights", "TaskCpuUtilization", "TaskMemoryUtilization"],
            ["AWS/ECS", "CPUUtilization", "MemoryUtilization"],
            ["ECS/ContainerInsights", "CpuUtilized", "MemoryUtilized"]
        ];
        var picked = nil;
        var t = 0;
        while (t < tries.length) {
            var row = tries[t];
            print "Trying " + row[0] + " " + row[1] + "/" + row[2] + "...";
            var got = pull(row[0], row[1], row[2]);
            if (got.cpu == nil) {
                print "  CPU error: " + cw.errorMessage(got.cpuXml);
            }
            if (got.mem == nil) {
                print "  Memory error: " + cw.errorMessage(got.memXml);
            }
            print "  datapoints: " + got.stamps.length;
            if (picked == nil and got.stamps.length > 0) {
                picked = got;
            }
            t = t + 1;
        }

        if (picked == nil) {
            print "";
            print "No datapoints on any metric name. Listing CloudWatch metrics for this cluster...";
            var listed = cw.listMetrics("ECS/ContainerInsights", nil, [awsDim("ClusterName", clusterName)]);
            if (listed == nil or strFind(listed, "<Error>") >= 0) {
                print "ListMetrics ECS/ContainerInsights: " + cw.errorMessage(listed);
                listed = cw.listMetrics("AWS/ECS", nil, [awsDim("ClusterName", clusterName)]);
                print "ListMetrics AWS/ECS: " + cw.errorMessage(listed);
            }
            var names = parseXml(listed, "MetricName");
            if (names == nil or names.length == 0) {
                dumpXml("ListMetrics", listed);
            } else {
                print "Available MetricName values:";
                var ni = 0;
                while (ni < names.length) {
                    print "  " + names[ni];
                    ni = ni + 1;
                }
            }
            print "If you see TaskCpuUtilization, re-run with that cluster/service name from ListMetrics dimensions.";
        } else {
            var cpu = picked.cpu;
            var mem = picked.mem;
            var stamps = picked.stamps;
            print "";
            print "Using " + picked.namespace + " " + picked.cpuName + "/" + picked.memName;
            print "datapoints: " + stamps.length;
            print "";
            print "--- sample ---";
            printSample(stamps, cpu, mem, clusterName, serviceName, 8);
            print "--- end sample ---";
            print "";
            var csv = buildCsv(stamps, cpu, mem, clusterName, serviceName);
            if (writeFile(outfile, csv)) {
                print "Wrote " + stamps.length + " rows to " + outfile;
            } else {
                print "Failed to write " + outfile;
            }
        }
    }
}
