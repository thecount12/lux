// Working AWS S3 Example - Makes real API calls!
// This demonstrates using httpRequest() with AWS Signature V4 to call S3

// Simple headers container
class Headers {
    init() {}
}

// Format current time for AWS
fun makeS3Request(accessKey, secretKey, region, bucket, method, key) {
    // Get current timestamp
    var timestamp = getAwsTimestamp();
    var amzDate = timestamp.amzDate;
    var dateStamp = timestamp.dateStamp;
    
    // Build host and URI
    var host = bucket + ".s3." + region + ".amazonaws.com";
    var uri = "/";
    if (key) {
        uri = "/" + key;
    }
    
    // Calculate payload hash (empty for GET)
    var payloadHash = sha256("");
    
    // Generate AWS Signature V4
    var authHeader = awsSignRequest(
        method,
        host,
        uri,
        "",              // No query string
        payloadHash,
        accessKey,
        secretKey,
        region,
        "s3",
        amzDate,
        dateStamp,
        nil              // No session token
    );
    
    // Build headers
    var headers = Headers();
    headers.Authorization = authHeader;
    headers.x_amz_date = amzDate;
    headers.x_amz_content_sha256 = payloadHash;
    
    // Make request
    var url = "https://" + host + uri;
    print "Calling: " + url;
    
    var response = httpRequest(method, url, nil, headers);
    return response;
}

