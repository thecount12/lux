// AWS helper demo — classes live in lib/aws.lux (safe to import).
// Loads .env via examples/config.lux. Run from posix/ or examples/.

import "../lib/aws.lux";
import "../examples/config.lux";

print "=== AWS Helper Module Demo ===\n";

if (aws == nil) {
    print "No credentials loaded.";
    print "Copy examples/env.example to .env and paste STS keys, then re-run.";
} else {
    print "Using access key " + strSlice(accessKey, 0, 8) + "... region=" + region;
    print "";

    var s3 = S3Client(aws);
    var bucketName = bucket;
    var argv = args();
    if (argv.length > 0) {
        bucketName = argv[0];
    }

    print "--- S3 ---";
    print "1. List Objects:";
    var listed = s3.listObjects(bucketName, "documents/");
    if (listed == nil) {
        print "  request failed";
    } else {
        print "  " + len(listed) + " bytes";
    }

    print "\n--- DynamoDB ---";
    var dynamodb = DynamoDBClient(aws);
    print "1. GetItem Users/user123:";
    var got = dynamodb.getItem("Users", makeKey("user123"));
    if (got == nil) {
        print "  request failed";
    } else {
        print "  " + got;
    }
}

print "\n=== Complete ===";
print "Clients: S3Client, DynamoDBClient, CloudWatchClient, BedrockRuntimeClient in lib/aws.lux";
print "Prometheus exporter: examples/aws_cloudwatch_prom.lux";
