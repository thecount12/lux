// AWS Helper Module - Reusable AWS signing and request utilities
// This shows how to structure AWS API calls from Lux

// Simple class to hold HTTP headers as instance fields
class AwsHeaders {
    init() {
        // Headers will be added as instance fields dynamically
    }
}

class AwsConfig {
    init(accessKey, secretKey, region, sessionToken) {
        this.accessKey = accessKey;
        this.secretKey = secretKey;
        this.region = region;
        this.sessionToken = sessionToken;
    }
}

class AwsRequest {
    init(config, service) {
        this.config = config;
        this.service = service;
    }
    
    // Build authorization header for a request
    // Returns an instance with header fields
    sign(method, host, uri, queryString, payload) {
        var timestamp = getAwsTimestamp();
        var amzDate = timestamp.amzDate;
        var dateStamp = timestamp.dateStamp;
        
        // Hash the payload
        var payloadHash = sha256(payload);
        
        // Generate signature
        var authHeader = awsSignRequest(
            method,
            host,
            uri,
            queryString,
            payloadHash,
            this.config.accessKey,
            this.config.secretKey,
            this.config.region,
            this.service,
            amzDate,
            dateStamp,
            this.config.sessionToken
        );
        
        // Create headers instance
        var headers = AwsHeaders();
        headers.Authorization = authHeader;
        headers.x_amz_date = amzDate;
        headers.x_amz_content_sha256 = payloadHash;
        
        // Add session token header if present
        if (this.config.sessionToken != nil) {
            headers.x_amz_security_token = this.config.sessionToken;
        }
        
        return headers;
    }
}

// S3-specific helper
class S3Client {
    init(config) {
        this.config = config;
        this.request = AwsRequest(config, "s3");
    }
    
    getHost(bucket) {
        return bucket + ".s3." + this.config.region + ".amazonaws.com";
    }
    
    // List objects with custom parsing
    listObjects(bucket, prefix) {
        var host = this.getHost(bucket);
        var queryString = "list-type=2";
        if (prefix) {
            queryString = queryString + "&prefix=" + prefix;
        }
        
        var headers = this.request.sign("GET", host, "/", queryString, "");
        var url = "https://" + host + "/?" + queryString;
        
        var response = httpRequest("GET", url, nil, headers);
        return response;
    }
    
    // Get object
    getObject(bucket, key) {
        var host = this.getHost(bucket);
        var uri = "/" + key;  // Should URL-encode in production
        
        var headers = this.request.sign("GET", host, uri, "", "");
        var url = "https://" + host + uri;
        
        var response = httpRequest("GET", url, nil, headers);
        return response;
    }
    
    // Put object
    putObject(bucket, key, content) {
        var host = this.getHost(bucket);
        var uri = "/" + key;  // Should URL-encode in production
        
        var headers = this.request.sign("PUT", host, uri, "", content);
        var url = "https://" + host + uri;
        
        var response = httpRequest("PUT", url, content, headers);
        return response;
    }
}

// DynamoDB-specific helper
class DynamoDBClient {
    init(config) {
        this.config = config;
        this.request = AwsRequest(config, "dynamodb");
        this.host = "dynamodb." + config.region + ".amazonaws.com";
    }
    
    // Generic DynamoDB operation
    call(target, payload) {
        var payloadJson = toJSON(payload);
        var headers = this.request.sign("POST", this.host, "/", "", payloadJson);
        
        // Add DynamoDB-specific headers
        headers.X_Amz_Target = target;
        headers.Content_Type = "application/x-amz-json-1.0";
        
        var url = "https://" + this.host + "/";
        var response = httpRequest("POST", url, payloadJson, headers);
        return response;
    }
    
    getItem(tableName, key) {
        return this.call(
            "DynamoDB_20120810.GetItem",
            {"TableName": tableName, "Key": key}
        );
    }
    
    putItem(tableName, item) {
        return this.call(
            "DynamoDB_20120810.PutItem",
            {"TableName": tableName, "Item": item}
        );
    }
}

// ===== Usage Examples =====

print "=== AWS Helper Module Demo ===\n";

// Example 1: Regular (permanent) credentials
print "--- Example 1: Permanent Credentials ---";
var config = AwsConfig(
    "AKIAIOSFODNN7EXAMPLE",
    "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    "us-east-1",
    nil  // No session token
);

// S3 Examples
print "\n--- S3 Examples ---";
var s3 = S3Client(config);

print "\n1. List Objects:";
s3.listObjects("my-bucket", "documents/");

print "\n2. Get Object:";
s3.getObject("my-bucket", "file.txt");

print "\n3. Put Object:";
s3.putObject("my-bucket", "newfile.txt", "Hello from Lux!");

// DynamoDB Examples
print "\n\n--- DynamoDB Examples ---";
var dynamodb = DynamoDBClient(config);

print "\n1. GetItem:";
dynamodb.getItem("Users", {"id": {"S": "user123"}});

print "\n2. PutItem:";
dynamodb.putItem("Users", {
    "id": {"S": "user456"},
    "name": {"S": "Alice"},
    "age": {"N": "30"}
});

// Example 2: STS Temporary Credentials
print "\n\n--- Example 2: STS Temporary Credentials ---";
print "Using temporary credentials from AssumeRole/GetSessionToken:";

var stsConfig = AwsConfig(
    "ASIAIOSFODNN7EXAMPLE",  // Temp access key (starts with ASIA)
    "wJalrXUtnFEMI/K7MDENG/bPxRfiCYTEMPORARYKEY",
    "us-east-1",
    "FwoGZXIvYXdzE...session-token..."  // Session token required!
);

var stsS3 = S3Client(stsConfig);
print "\nS3 with temporary credentials:";
stsS3.listObjects("secure-bucket", "confidential/");

var stsDynamodb = DynamoDBClient(stsConfig);
print "\nDynamoDB with temporary credentials:";
stsDynamodb.getItem("SecureTable", {"id": {"S": "sensitive-123"}});

print "\n\n=== Complete! ===";
print "Next steps:";
print "1. Implement proper timestamp generation (from clock())";
print "2. Add URL encoding for S3 keys";
print "3. Extend httpGet/httpPost to accept custom headers";
print "4. Parse XML/JSON responses";
