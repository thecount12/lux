/* Hand check: relu([1, 2] @ I + [0, -3]) is [1, 0].
 * Run from posix/: ./lux ../examples/tensor_check.lux
 */

var x = Tensor(1, 2);
x.set(0, 0, 1);
x.set(0, 1, 2);

var W = Tensor(2, 2);
W.set(0, 0, 1);
W.set(0, 1, 0);
W.set(1, 0, 0);
W.set(1, 1, 1);

var b = Tensor(1, 2);
b.set(0, 0, 0);
b.set(0, 1, -3);

var y = x.matmul(W).addBias(b).relu();
y.show("relu(x @ W + b)");
assert(y.get(0, 0) == 1, "relu col 0");
assert(y.get(0, 1) == 0, "relu col 1");
print "tensor check passed";
