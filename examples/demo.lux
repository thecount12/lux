// Simple Lux Demo - Working Examples
// Demonstrates core features without type concatenation issues

print "=== Lux Language Demo ===";
print "";

// ============================================
// 1. Variables and Strings
// ============================================
print "--- Variables ---";
var message = "Hello from Lux!";
var name = "Alice";
print message;
print name;
print "";

// ============================================
// 2. Math
// ============================================
print "--- Math ---";
var x = 10;
var y = 3;
print "x = " + x + ", y = " + y;
print "Sum: " + (x + y);
print "Product: " + (x * y);
print "";

// ============================================
// 3. Control Flow
// ============================================
print "--- Control Flow ---";

if (x > y) {
    print "x is greater";
}

print "Countdown:";
var count = 3;
while (count > 0) {
    print count;
    count = count - 1;
}
print "Done!";
print "";

// ============================================
// 4. Functions
// ============================================
print "--- Functions ---";

fun greet(name) {
    return "Hello, " + name + "!";
}

print greet("World");
print greet("Lux");

fun add(a, b) {
    return a + b;
}

print "5 + 7 = " + add(5, 7);
print "";

// ============================================
// 5. Closures
// ============================================
print "--- Closures ---";

fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

var counter = makeCounter();
print "Counter: " + counter();
print "Counter: " + counter();
print "Counter: " + counter();
print "";

// ============================================
// 6. Classes
// ============================================
print "--- Classes ---";

class Dog {
    init(name) {
        this.name = name;
    }

    bark() {
        print this.name + " says woof!";
    }

    rename(newName) {
        this.name = newName;
    }
}

var buddy = Dog("Buddy");
buddy.bark();
buddy.rename("Max");
buddy.bark();
print "";

// ============================================
// 7. Inheritance
// ============================================
print "--- Inheritance ---";

class Animal {
    init(name) {
        this.name = name;
    }

    speak() {
        print this.name + " makes a sound";
    }
}

class Cat < Animal {
    speak() {
        print this.name + " meows!";
    }
}

var whiskers = Cat("Whiskers");
whiskers.speak();
print "";

// ============================================
// 8. Practical Example
// ============================================
print "--- Practical: Counter Class ---";

class ScoreKeeper {
    init(playerName) {
        this.player = playerName;
        this.score = 0;
    }

    addPoints() {
        this.score = this.score + 10;
        print this.player + " scored!";
    }

    showScore() {
        print this.player + "'s score:";
        print this.score;
    }
}

var game = ScoreKeeper("Player One");
game.addPoints();
game.addPoints();
game.addPoints();
game.showScore();
print "";

// ============================================
// 9. Multiple Objects
// ============================================
print "--- Multiple Objects ---";

class Point {
    init(x, y) {
        this.x = x;
        this.y = y;
    }

    display() {
        print "Point at: (" + this.x + ", " + this.y + ")";
    }
}

var p1 = Point(10, 20);
var p2 = Point(30, 40);

p1.display();
p2.display();
print "";

// ============================================
// 10. Method Chaining
// ============================================
print "--- Method Chaining ---";

class Builder {
    init() {
        this.value = 0;
    }

    add(n) {
        this.value = this.value + n;
        return this;
    }

    multiply(n) {
        this.value = this.value * n;
        return this;
    }

    result() {
        print "Result: " + this.value;
    }
}

var calc = Builder();
calc.add(5).add(3).multiply(2).result();
print "";

print "=== Demo Complete! ===";
print "Key Features Shown:";
print "- Variables and types";
print "- Functions and closures";
print "- Classes and inheritance";
print "- Object-oriented design";
print "";
print "Next steps:";
print "- Check ch29-inherit.lux for more inheritance";
print "- Check closures.lux for closure examples";
print "- Try writing your own Lux programs!";
