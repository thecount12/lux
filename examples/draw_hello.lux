/* Tiny Draw window. One window per process. Close with the window
 * manager or press q. Click (not motion) to draw dots.
 *
 * POSIX (plan9port):
 *   cd posix && make USE_P9P=1
 *   ./lux ../examples/draw_hello.lux
 *
 * Plan 9:
 *   mk
 *   8.out examples/draw_hello.lux
 */

if (!draw_available()) {
    print "draw_available() is false — rebuild POSIX with USE_P9P=1";
    exit(1);
}

var w = Draw("lux", 640, 480);
if (w == nil) {
    print "Draw() failed (already open, or no display)";
    exit(1);
}

fun paint() {
    w.fill(0, 0, w.width, w.height, "#111111");
    w.string(8, 4, "hello from lux — click, type, or q to quit", "#eeeeee");
    w.flush();
}

paint();

while (true) {
    var e = w.event();
    if (e == nil) {
        break;
    }
    if (e.kind == "quit") {
        break;
    }
    if (e.kind == "resize") {
        paint();
    }
    if (e.kind == "kbd" and e.r == 113) {
        break; /* 'q' */
    }
    if (e.kind == "mouse" and e.button != 0) {
        w.fill(e.x - 2, e.y - 2, 5, 5, "#66ccff");
        w.flush();
    }
}

w.close();
