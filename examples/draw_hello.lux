/* Tiny Draw window. One window per process. Close with the window
 * manager or press q.
 *
 * POSIX (plan9port):
 *   cd posix && make USE_P9P=1
 *   ./lux ../examples/draw_hello.lux
 *
 * Plan 9:
 *   mk
 *   8.out examples/draw_hello.lux
 */

if (!draw_available()) {
    print "draw_available() is false — rebuild POSIX with USE_P9P=1";
    exit(1);
}

var w = Draw("lux", 640, 480);
if (w == nil) {
    print "Draw() failed (already open, or no display)";
    exit(1);
}

w.fill(0, 0, 640, 480, "#111111");
w.string(16, 24, "hello from lux — click, type, or q to quit", "#eeeeee");
w.flush();

while (true) {
    var e = w.event();
    if (e == nil) {
        break;
    }
    print e.kind;
    if (e.kind == "quit") {
        break;
    }
    if (e.kind == "kbd" && e.r == 113) {
        break; /* 'q' */
    }
    if (e.kind == "mouse") {
        w.fill(e.x - 2, e.y - 2, 5, 5, "#66ccff");
        w.flush();
    }
}

w.close();
