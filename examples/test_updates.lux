// Comprehensive test of updated .lux files
// Run this to verify all examples work with new concatenation

print "=== Testing Updated Files ===";
print "";

// Test 1: Basic concatenation
print "Test 1: Basic concatenation";
var score = 42;
var level = 10;
print "Score: " + score + ", Level: " + level;
print "Pass!";
print "";

// Test 2: Class with numeric properties
print "Test 2: Class with numeric properties";
class Stats {
    init(hp, mp) {
        this.hp = hp;
        this.mp = mp;
    }
    
    show() {
        print "HP: " + this.hp + " / MP: " + this.mp;
    }
}

var player = Stats(100, 50);
player.show();
print "Pass!";
print "";

// Test 3: Boolean concatenation
print "Test 3: Boolean values";
var ready = true;
var active = false;
print "Ready: " + ready + ", Active: " + active;
print "Pass!";
print "";

// Test 4: Nil concatenation
print "Test 4: Nil value";
var nothing = nil;
print "Value: " + nothing;
print "Pass!";
print "";

// Test 5: Mixed expression
print "Test 5: Complex expression";
var name = "Alice";
var age = 30;
var result = name + " (age " + age + ") scored " + 1000 + " points";
print result;
print "Pass!";
print "";

// Test 6: Numeric addition still works
print "Test 6: Numeric addition";
var a = 10;
var b = 20;
print "10 + 20 = " + (a + b);
print a + b;  // Should print 30, not "1020"
print "Pass!";
print "";

print "=== All Tests Passed! ===";
print "";
