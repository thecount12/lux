// Lux Language Tutorial - Essential Feature Demo

print "=== Welcome to Lux! ===";
print "";

// Variables and Types
print "--- Variables ---";
var name = "Lux";
var number = 42;
var flag = true;

print "Name: " + name;
print "Number: " + number;
print "";

// Control Flow
print "--- Control Flow ---";
var x = 10;
if (x > 5) {
    print "x is big";
}

var countdown = 3;
while (countdown > 0) {
    print countdown;
    countdown = countdown - 1;
}
print "";

// Functions
print "--- Functions ---";
fun greet(person) {
    return "Hello, " + person;
}
print greet("World");
print "";

// Closures
print "--- Closures ---";
fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

var counter = makeCounter();
print "Count: " + counter();
print "Count: " + counter();
print "";

// Classes
print "--- Classes ---";
class Dog {
    init(dogName) {
        this.dogName = dogName;
    }
    
    bark() {
        print this.dogName + " barks!";
    }
}

var buddy = Dog("Buddy");
buddy.bark();
print "";

// Arrays
print "--- Arrays ---";
var nums = [10, 20, 30];
print "First: " + nums[0];
print "Length: " + nums.length;

print "All elements:";
var i = 0;
while (i < nums.length) {
    print "  " + nums[i];
    i = i + 1;
}
print "";

print "=== Tutorial Complete! ===";
