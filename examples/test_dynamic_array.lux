print("Dynamic array test");

var a = [];
a[0] = "first";
a[3] = "fourth";
a[1] = "second";

print(a.length);  // 4
print(a[0]);      // first
print(a[1]);      // second
print(a[2]);      // nil
print(a[3]);      // fourth

a[10] = "eleventh";
print(a.length);  // 11
print(a[9]);      // nil
print(a[10]);     // eleventh
