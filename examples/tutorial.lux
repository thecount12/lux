// Lux Language Tutorial - Comprehensive Feature Demo
// Based on Chapters 1-30 of Crafting Interpreters

print "=== Welcome to Lux! ===";
print "";

// ============================================
// 1. VARIABLES AND BASIC TYPES
// ============================================
print "--- Variables and Types ---";
var name = "Lux";
var version = 1.0;
var isAwesome = true;
var nothing = nil;

print "Language: " + name;
print "Version: " + version;
print "Awesome: " + isAwesome;
print "";

// ============================================
// 2. ARITHMETIC AND COMPARISONS
// ============================================
print "--- Math ---";
var x = 10;
var y = 3;

print "Sum: " + (x + y);
print "Product: " + (x * y);
print "x > y: " + (x > y);
print "";

// ============================================
// 3. CONTROL FLOW
// ============================================
print "--- Control Flow ---";

if (x > 5) {
    print "x is big";
}

var count = 3;
while (count > 0) {
    print count;
    count = count - 1;
}
print "";

// ============================================
// 4. FUNCTIONS
// ============================================
print "--- Functions ---";

fun greet(name) {
    return "Hello, " + name;
}

print greet("World");

fun fib(n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

print "Fib(10) = " + fib(10);
print "";

// ============================================
// 5. CLOSURES
// ============================================
print "--- Closures ---";

fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

var counter = makeCounter();
print "Counter: " + counter();
print "Counter: " + counter();
print "Counter: " + counter();
print "";

// ============================================
// 6. CLASSES AND OBJECTS
// ============================================
print "--- Classes ---";

class Person {
    init(name, age) {
        this.name = name;
        this.age = age;
    }

    greet() {
        print "Hi, I'm " + this.name;
    }
}

var alice = Person("Alice", 30);
alice.greet();
print "";

// ============================================
// 7. INHERITANCE
// ============================================
print "--- Inheritance ---";

class Animal {
    init(name) {
        this.name = name;
    }

    speak() {
        return this.name + " makes a sound";
    }
}

class Dog < Animal {
    speak() {
        return this.name + " barks!";
    }
}

var buddy = Dog("Buddy");
print buddy.speak();
print "";

// ============================================
// 8. ARRAYS
// ============================================
print "--- Arrays ---";

var numbers = [10, 20, 30, 40, 50];
var names = ["Alice", "Bob", "Charlie"];

print "Array created";
print "First: " + numbers[0];
print "Last: " + numbers[4];
print "Length: " + numbers.length;

// Modify elements
numbers[0] = 100;
print "Updated first: " + numbers[0];

// Iterate
print "Names:";
var i = 0;
while (i < names.length) {
    print "  " + names[i];
    i = i + 1;
}

// Nested arrays
var matrix = [[1, 2, 3], [4, 5, 6]];
print "Matrix[1][2] = " + matrix[1][2];
print "";

print "=== Tutorial Complete! ===";

