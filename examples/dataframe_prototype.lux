// Pure-Lux DataFrame prototype with quoted CSV parser

fun _append(arr, val) {
    arr[arr.length] = val;
    return arr;
}

// CSV parser that supports quoted fields, escaped quotes ("")
fun parseCSVQuoted(text, sep) {
    if (sep == nil) sep = ",";
    var rows = [];
    var row = [];
    var field = "";
    var inQuotes = false;
    var i = 0;
    var L = len(text);
    while (i < L) {
        var ch = text[i];
        // handle CR by skipping
        if (ch == "\r") {
            i = i + 1;
            continue;
        }

        if (inQuotes) {
            if (ch == "\"") {
                // lookahead for escaped quote
                if (i + 1 < L && text[i + 1] == "\"") {
                    field = field + "\"";
                    i = i + 2;
                    continue;
                } else {
                    inQuotes = false;
                    i = i + 1;
                    continue;
                }
            } else {
                field = field + ch;
                i = i + 1;
                continue;
            }
        } else {
            if (ch == "\"") {
                inQuotes = true;
                i = i + 1;
                continue;
            }
            if (ch == sep) {
                // end field
                _append(row, strTrim(field));
                field = "";
                i = i + 1;
                continue;
            }
            if (ch == "\n") {
                _append(row, strTrim(field));
                field = "";
                _append(rows, row);
                row = [];
                i = i + 1;
                continue;
            }
            // regular char
            field = field + ch;
            i = i + 1;
            continue;
        }
    }
    // append last field/row if any
    if (inQuotes) {
        // unterminated quotes - treat as field content (lenient)
        // proceed to close
        inQuotes = false;
    }
    // append remaining
    if (!(field == "" && row.length == 0 && rows.length == 0)) {
        _append(row, strTrim(field));
        _append(rows, row);
    }
    return rows;
}

class DataFrame {
    init(names, cols) {
        if (IS_OBJ(names) && !IS_NUMBER(names)) {
            var rows = names;
            if (rows.length == 0) {
                this.names = [];
                this.cols = [];
                this.n = 0;
                return;
            }
            var header = rows[0];
            this.names = header;
            this.cols = [];
            var c = 0;
            while (c < header.length) {
                this.cols[c] = [];
                c = c + 1;
            }
            var r = 1;
            while (r < rows.length) {
                var row = rows[r];
                var k = 0;
                while (k < header.length) {
                    var val = nil;
                    if (k < row.length) val = row[k];
                    this.cols[k][this.cols[k].length] = val;
                    k = k + 1;
                }
                r = r + 1;
            }
            this.n = this.cols.length == 0 ? 0 : this.cols[0].length;
        } else {
            this.names = names;
            this.cols = cols;
            this.n = cols.length == 0 ? 0 : cols[0].length;
        }
    }

    head(k) {
        if (k == nil) k = 5;
        var newCols = [];
        var i = 0;
        while (i < this.cols.length) {
            newCols[i] = [];
            var j = 0;
            while (j < k && j < this.cols[i].length) {
                newCols[i][j] = this.cols[i][j];
                j = j + 1;
            }
            i = i + 1;
        }
        return DataFrame(this.names, newCols);
    }

    select(keepNames) {
        var newNames = [];
        var newCols = [];
        var i = 0;
        while (i < keepNames.length) {
            var name = keepNames[i];
            var idx = this._colIndex(name);
            if (idx != -1) {
                newNames[newNames.length] = name;
                newCols[newCols.length] = this.cols[idx];
            }
            i = i + 1;
        }
        return DataFrame(newNames, newCols);
    }

    _colIndex(name) {
        var i = 0;
        while (i < this.names.length) {
            if (this.names[i] == name) return i;
            i = i + 1;
        }
        return -1;
    }

    rowAsObj(i) {
        var R = {};
        var c = 0;
        while (c < this.names.length) {
            R[this.names[c]] = this.cols[c][i];
            c = c + 1;
        }
        return R;
    }

    filter(pred) {
        var keepIdx = [];
        var i = 0;
        while (i < this.n) {
            var row = this.rowAsObj(i);
            if (pred(row)) _append(keepIdx, i);
            i = i + 1;
        }
        var newCols = [];
        var c = 0;
        while (c < this.cols.length) {
            newCols[c] = [];
            var k = 0;
            while (k < keepIdx.length) {
                newCols[c][k] = this.cols[c][keepIdx[k]];
                k = k + 1;
            }
            c = c + 1;
        }
        return DataFrame(this.names, newCols);
    }

    mapColumn(name, fn) {
        var idx = this._colIndex(name);
        if (idx == -1) return false;
        var i = 0;
        while (i < this.n) {
            this.cols[idx][i] = fn(this.cols[idx][i]);
            i = i + 1;
        }
        return true;
    }

    to_csv(sep) {
        if (sep == nil) sep = ",";
        var out = "";
        var i = 0;
        while (i < this.names.length) {
            out = out + this.names[i];
            if (i + 1 < this.names.length) out = out + sep;
            i = i + 1;
        }
        out = out + "\n";
        var r = 0;
        while (r < this.n) {
            var c = 0;
            while (c < this.names.length) {
                var v = this.cols[c][r];
                if (v == nil) v = "";
                out = out + v;
                if (c + 1 < this.names.length) out = out + sep;
                c = c + 1;
            }
            out = out + "\n";
            r = r + 1;
        }
        return out;
    }

    describe() {
        var res = {};
        var c = 0;
        while (c < this.names.length) {
            var name = this.names[c];
            var sum = 0;
            var cnt = 0;
            var i = 0;
            while (i < this.n) {
                var v = this.cols[c][i];
                if (v != nil) {
                    var n = v * 1;
                    if (n != nil && n == n) {
                        sum = sum + n;
                        cnt = cnt + 1;
                    }
                }
                i = i + 1;
            }
            res[name] = {"count": cnt, "mean": (cnt == 0 ? nil : (sum / cnt))};
            c = c + 1;
        }
        return res;
    }
}

// Convenience: read CSV text or file path -> DataFrame
fun read_csv_text(text, sep) {
    var rows = parseCSVQuoted(text, sep);
    if (rows.length == 0) return DataFrame([], []);
    return DataFrame(rows);
}

fun read_csv_file(path, sep) {
    var txt = readFile(path);
    if (txt == nil) return nil;
    return read_csv_text(txt, sep);
}

// Example quick usage when run:
// var txt = "name,age,notes\n\"Smith, John\",30,\"Likes \\\"quotes\\\" and, commas\"\nAlice,25,ok";
// var df = read_csv_text(txt);
// print df.head(2).to_csv();

// Float64 example (POSIX only). If you want to force-disable this example
// (e.g. when running on Plan 9), set USE_FLOAT64 = false below.
var USE_FLOAT64 = float64_available(); // set to false to disable regardless of availability

if (USE_FLOAT64) {
    // Build a tiny numeric DataFrame and demonstrate Float64Array usage
    var txt = "name,val\nA,1.5\nB,2.5\nC,3.0";
    var df = read_csv_text(txt);

    // Coerce to numeric strings -> numbers in-place
    df.mapColumn("val", fun(v) { return v * 1; });

    // Create a Float64Array and copy the numeric column into it
    var idx = df._colIndex("val");
    var fa = float64_new(df.n);
    var i = 0;
    while (i < df.n) {
        float64_set(fa, i, df.cols[idx][i] * 1);
        i = i + 1;
    }

    // Compute sum via dot product with a ones vector
    var ones = float64_new(df.n);
    var j = 0;
    while (j < df.n) {
        float64_set(ones, j, 1);
        j = j + 1;
    }
    var sum = float64_dot(fa, ones);
    print "Float64 sum: " + sum;
    print "Float64 mean: " + (sum / df.n);
} else {
    print "Float64 not available or disabled (USE_FLOAT64=" + USE_FLOAT64 + ")";
}

