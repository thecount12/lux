// DataFrame demo — import the stdlib, then print a few operations.
import "../lib/dataframe.lux";

var txt = "name,age,notes\n\"Smith, John\",30,\"likes quotes\"\nAlice,25,ok\nBob,40,ok";
var df = read_csv_text(txt);
print df.head(2).to_csv();

df.toNumber("age");
print "mean age rows: " + df.describe().n;

var byAge = df.sortBy("age");
print "sorted names: " + byAge.cols[0][0] + ", " + byAge.cols[0][1] + ", " + byAge.cols[0][2];

if (float64_available()) {
    var fa = float64_new(df.n);
    var i = 0;
    while (i < df.n) {
        float64_set(fa, i, df.cols[df._colIndex("age")][i]);
        i = i + 1;
    }
    var ones = float64_new(df.n);
    var j = 0;
    while (j < df.n) {
        float64_set(ones, j, 1);
        j = j + 1;
    }
    var sum = float64_dot(fa, ones);
    print "Float64 sum: " + sum;
    print "Float64 mean: " + (sum / df.n);
} else {
    print "Float64 not available";
}
