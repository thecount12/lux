/* Minimal template renderer example for Lux
 *
 * - Supports simple {{ var }} interpolation (dotted keys)
 * - Supports {% include "path" %} (relative to template path)
 *
 * Drop into examples/ and run alongside the static server examples.
 */

fun escapeHtml(s) {
  if (s == nil) return "";
  var out = s + ""; // coerce to string

  // Replace &, <, >, ", '
  var parts = strSplit(out, "&");
  out = "";
  var i = 0;
  while (i < parts.length) {
    if (i > 0) out = out + "&amp;";
    out = out + parts[i];
    i = i + 1;
  }

  parts = strSplit(out, "<");
  out = "";
  i = 0;
  while (i < parts.length) {
    if (i > 0) out = out + "&lt;";
    out = out + parts[i];
    i = i + 1;
  }

  parts = strSplit(out, ">");
  out = "";
  i = 0;
  while (i < parts.length) {
    if (i > 0) out = out + "&gt;";
    out = out + parts[i];
    i = i + 1;
  }

  parts = strSplit(out, "\"");
  out = "";
  i = 0;
  while (i < parts.length) {
    if (i > 0) out = out + "&quot;";
    out = out + parts[i];
    i = i + 1;
  }

  parts = strSplit(out, "'");
  out = "";
  i = 0;
  while (i < parts.length) {
    if (i > 0) out = out + "&#39;";
    out = out + parts[i];
    i = i + 1;
  }

  return out;
}

// Use the native Dict class provided by the runtime (methods: put, get, has, iter, size, remove).

// dotted key lookup: "user.name.first"
// dotted key lookup: "user.name.first"
// supports optional locals for loop variables: lookup(ctx, key, locals)
fun lookup(ctx, key, locals) {
  if (key == nil) return nil;
  key = key + ""; // coerce to string
  var parts = strSplit(key, ".");
  if (parts == nil) return nil;
  var cur = nil;

  // Resolve the first part: prefer locals, then ctx (supports Dict.put/get)
  if (parts.length == 0) return nil;
  var first = parts[0];
  if (locals != nil) {
    if (locals.get != nil) {
      cur = locals.get(first);
    } else {
      cur = locals[first];
    }
  }

  if (cur == nil) {
    if (ctx.get != nil) {
      cur = ctx.get(first);
    } else {
      // fallback: numeric index or direct property (best-effort)
      var idx0 = first * 1;
      if (idx0 == idx0) {
        cur = ctx[idx0];
      } else {
        cur = ctx[first];
      }
    }
  }

  // Walk remaining dotted parts using numeric indexing only (objects are limited).
  var i = 1;
  while (i < parts.length) {
    if (cur == nil) return nil;
    var k = parts[i];
    var idx = k * 1;
    if (idx == idx) {
      cur = cur[idx];
    } else {
      // cannot access non-numeric nested properties reliably
      return nil;
    }
    i = i + 1;
  }
  return cur;
}

// return index of last occurrence of needle, or -1
fun lastIndexOf(text, needle) {
  var last = -1;
  var cursor = 0;
  while (true) {
    var idx = strFind(text, needle, cursor);
    if (idx == -1) break;
    last = idx;
    cursor = idx + 1;
  }
  return last;
}

// renderTemplate(path, ctx) -> string
fun renderTemplate(path, ctx) {
  var src = readFile(path);
  if (src == nil) {
    return "Template not found: " + path;
  }

  // Handle simple include tags: {% include "file" %}
  var cursor = 0;
  while (true) {
    var incStart = strFind(src, "{% include \"", cursor);
    if (incStart == -1) break;
    var quoteStart = incStart + len("{% include \"");
    var quoteEnd = strFind(src, "\"", quoteStart);
    if (quoteEnd == -1) break;
    var incPath = strSlice(src, quoteStart, quoteEnd);

    // Resolve relative include: compute template directory
    var slashIdx = lastIndexOf(path, "/");
    var base = "";
    if (slashIdx != -1) {
      base = strSlice(path, 0, slashIdx + 1);
    }
    var fullInc = base + incPath;

    var incContent = renderTemplate(fullInc, ctx);

    // find end of tag "%}"
    var tagEnd = strFind(src, "%}", quoteEnd);
    if (tagEnd == -1) break;
    tagEnd = tagEnd + len("%}");

    // replace the tag with included content
    var before = strSlice(src, 0, incStart);
    var after = strSlice(src, tagEnd, len(src));
    src = before + incContent + after;
    cursor = incStart + len(incContent);
  }

  // Handle simple for-loops: {% for item in items %} ... {% endfor %}
  // This is non-nested (does not support nested for loops).
  var outSrc = src;
  cursor = 0;
  while (true) {
    var forStart = strFind(outSrc, "{% for ", cursor);
    if (forStart == -1) break;
    var forTagEnd = strFind(outSrc, "%}", forStart);
    if (forTagEnd == -1) break;
    var forExpr = strSlice(outSrc, forStart + len("{% for "), forTagEnd);
    // parse "var in iterable" without relying on strSplit to avoid runtime issues
    var inIdx = strFind(forExpr, " in ");
    if (inIdx == -1) {
      cursor = forTagEnd + 2;
      continue;
    }
    var varName = strTrim(strSlice(forExpr, 0, inIdx));
    var iterableKey = strTrim(strSlice(forExpr, inIdx + len(" in "), len(forExpr)));

    // find matching endfor
    var endTag = strFind(outSrc, "{% endfor %}", forTagEnd);
    if (endTag == -1) break;

    var innerStart = forTagEnd + len("%}");
    var inner = strSlice(outSrc, innerStart, endTag);

    var iterable = lookup(ctx, iterableKey, nil);
    var rendered = "";
    if (iterable != nil) {
      var j = 0;
      var L = len(iterable);
      while (j < L) {
        var elem = iterable[j];
        // replace occurrences of the loop variable ({{ varName }}) directly
        var innerWithVar = replaceLoopVar(inner, varName, elem);
        rendered = rendered + interpolateString(innerWithVar, ctx, nil);
        j = j + 1;
      }
    }

    // replace the whole for...endfor block with rendered content
    var before = strSlice(outSrc, 0, forStart);
    var after = strSlice(outSrc, endTag + len("{% endfor %}"), len(outSrc));
    outSrc = before + rendered + after;
    cursor = len(before) + len(rendered);
  }

  // Final interpolation for remaining {{ }} with support for locals (none)
  var out = interpolateString(outSrc, ctx, nil);
  return out;
}

// replaceLoopVar(src, varName, elem) -> string
fun replaceLoopVar(src, varName, elem) {
  var out = "";
  var cursor = 0;
  while (cursor < len(src)) {
    var openIdx = strFind(src, "{{", cursor);
    if (openIdx == -1) {
      out = out + strSlice(src, cursor, len(src));
      break;
    }
    out = out + strSlice(src, cursor, openIdx);
    var closeIdx = strFind(src, "}}", openIdx + 2);
    if (closeIdx == -1) {
      out = out + strSlice(src, openIdx, len(src));
      break;
    }
    var keyRaw = strSlice(src, openIdx + 2, closeIdx);
    var key = strTrim(keyRaw);
    if (key == varName) {
      out = out + escapeHtml(elem + "");
    } else {
      out = out + strSlice(src, openIdx, closeIdx + 2);
    }
    cursor = closeIdx + 2;
  }
  return out;
}
// interpolateString(src, ctx, locals) -> string
fun interpolateString(src, ctx, locals) {
  var out = "";
  var cursor = 0;
  while (cursor < len(src)) {
    var openIdx = strFind(src, "{{", cursor);
    if (openIdx == -1) {
      out = out + strSlice(src, cursor, len(src));
      break;
    }
    out = out + strSlice(src, cursor, openIdx);
    var closeIdx = strFind(src, "}}", openIdx + 2);
    if (closeIdx == -1) {
      out = out + strSlice(src, openIdx, len(src));
      break;
    }
    var keyRaw = strSlice(src, openIdx + 2, closeIdx);
    var key = strTrim(keyRaw);
    var val = lookup(ctx, key, locals);
    if (val == nil) {
      out = out + "";
    } else {
      out = out + escapeHtml(val + "");
    }
    cursor = closeIdx + 2;
  }
  return out;
}

// Example server wiring. Serves static files and renders a template at "/".
fun handleRoot(req, res) {
  var ctx = Dict();
  ctx.put("title", "Lux Template Example");
  ctx.put("items", ["One", "Two", "Three"]);

  var html = renderTemplate("examples/static/templates/index.tpl", ctx);
  // send HTML response
  res.send(html);
}

fun handleApi(req, res) {
  res.json(parseJSON("{\"message\":\"Hello from Lux API\"}"));
}

var server = Server(8083);
server.static("examples/static/www");
server.get("/", handleRoot);
// additional route demonstrating the same template rendering
fun handleList(req, res) {
  var ctx = Dict();
  ctx.put("title", "Lux Template List");
  ctx.put("items", ["Apple", "Banana", "Cherry", "Date"]);
  var html = renderTemplate("examples/static/templates/index.tpl", ctx);
  res.send(html);
}
server.get("/list", handleList);
server.get("/api/hello", handleApi);
print "Starting template server on http://localhost:8083/";
server.start();

