/* Simple Lux example: serve static files and provide a small API endpoint */
fun handleApi(req, res) {
  res.json(parseJSON("{\"message\":\"Hello from Lux API\"}"));
}

var server = Server(8082);
/* Serve files from examples/static/www - GET / will serve index.html */
server.static("static/www");
server.get("/api/hello", handleApi);

print "Starting server on http://localhost:8082/";
server.start();

