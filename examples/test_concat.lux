// Test automatic string concatenation
print "=== Testing String + Number Concatenation ===";
print "";

// String + Number
print "Score: " + 42;
print "Level: " + 10;
print "Health: " + 100;

// Number + String
print 99 + " bottles";
print 5 + " apples";

// String + Boolean
print "Ready: " + true;
print "Active: " + false;

// String + Nil
print "Value: " + nil;

// Multiple concatenation
print "Player " + 1 + " scored " + 100 + " points";

// In expressions
var score = 42;
var message = "Your score is: " + score;
print message;

// With variables
var name = "Alice";
var age = 30;
print name + " is " + age + " years old";

// Number + Number still works
print 10 + 20;

// String + String still works
print "Hello " + "World";

print "";
print "All tests complete!";
