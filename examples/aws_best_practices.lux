    var uploaded = s3PutSafe(config, "test/demo.txt", testContent)
    if (uploaded) {
        print "Upload successful"
        
        print "Downloading back..."
        var downloaded = s3GetSafe(config, "test/demo.txt")
        if (downloaded != nil) {
            print "Downloaded: " + downloaded
        }
    }
    print ""
    
    // Example 3: JSON workflow
    print "Example 3: JSON data workflow"
    class Sample {
        init(id, value) {
            this.id = id
            this.value = value
            this.timestamp = clock()
        }
    }
    
    var sample = Sample(123, 456)
    var json = toJSON(sample)
    if (json != nil) {
        var key = "data/sample.json"
        if (s3PutSafe(config, key, json)) {
            print "JSON uploaded to " + key
        }
    }
}

