// Chapter 28: Comprehensive Test
// Tests all features: methods, init, this, and invoke optimization

print "=== Test 1: Basic Methods ===";
class Cat {
    meow() {
        print "Meow!";
    }
}
var cat = Cat();
cat.meow();


print "\n=== Test 2: Methods with Parameters ===";
class Adder {
    add(a, b) {
        return a + b;
    }
}
var adder = Adder();
print adder.add(10, 20);


print "\n=== Test 3: The 'this' Keyword ===";
class Person {
    sayName() {
        print "My name is " + this.name;
    }
}
var person = Person();
person.name = "Alice";
person.sayName();


print "\n=== Test 4: Init Method ===";
class Rectangle {
    init(width, height) {
        this.width = width;
        this.height = height;
        print "Rectangle created";
    }
    
    area() {
        return this.width * this.height;
    }
}
var rect = Rectangle(5, 10);
print "Area: ";
print rect.area();


print "\n=== Test 5: Method Chaining ===";
class Chainable {
    init() {
        this.value = 0;
    }
    
    increment() {
        this.value = this.value + 1;
        return this;
    }
    
    decrement() {
        this.value = this.value - 1;
        return this;
    }
    
    show() {
        print "Value: ";
        print this.value;
        return this;
    }
}
Chainable().increment().increment().increment().show();


print "\n=== Test 6: Multiple Instances ===";
class Account {
    init(name, balance) {
        this.name = name;
        this.balance = balance;
    }
    
    describe() {
        print this.name;
        print " has $";
        print this.balance;
    }
}
var acc1 = Account("Alice", 100);
var acc2 = Account("Bob", 200);
acc1.describe();
acc2.describe();


print "\n=== Test 7: Methods Calling Methods ===";
class Complex {
    init(value) {
        this.value = value;
    }
    
    double() {
        this.value = this.value * 2;
    }
    
    triple() {
        this.double();
        this.value = this.value + this.value / 2;
    }
    
    show() {
        print this.value;
    }
}
var c = Complex(10);
c.triple();
c.show();


print "\n=== All Tests Complete ===";
