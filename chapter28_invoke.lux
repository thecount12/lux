// Chapter 28: Method Invocation Optimization
// The OP_INVOKE instruction combines property lookup and call into one operation
// This is an optimization for: obj.method(args)

// Simple invocation - uses OP_INVOKE internally
class Greeter {
    greet(name) {
        print "Hello, " + name + "!";
    }
}

var greeter = Greeter();
greeter.greet("World");  // This uses OP_INVOKE optimization


// Performance comparison scenario
// obj.method() is faster than separate get + call
class FastCalculator {
    square(n) {
        return n * n;
    }
    
    cube(n) {
        return n * n * n;
    }
}

var calc = FastCalculator();

// These all use OP_INVOKE (optimized):
print calc.square(5);
print calc.cube(3);

// Whereas storing in a variable and calling uses separate operations:
var squareFunc = calc.square;  // OP_GET_PROPERTY
// Can't call squareFunc directly in this chapter (needs closures bound to this)


// Chained method calls
class Counter {
    init(start) {
        this.value = start;
    }
    
    add(n) {
        this.value = this.value + n;
        return this;
    }
    
    subtract(n) {
        this.value = this.value - n;
        return this;
    }
    
    multiply(n) {
        this.value = this.value * n;
        return this;
    }
    
    getValue() {
        return this.value;
    }
}

// Each method call uses OP_INVOKE
var result = Counter(10)
    .add(5)
    .multiply(2)
    .subtract(3)
    .getValue();
print result;  // (10 + 5) * 2 - 3 = 27


// Multiple invocations in expressions
class Math {
    min(a, b) {
        if (a < b) return a;
        return b;
    }
    
    max(a, b) {
        if (a > b) return a;
        return b;
    }
    
    abs(n) {
        if (n < 0) return -n;
        return n;
    }
}

var math = Math();
print math.min(5, 8);
print math.max(5, 8);
print math.abs(-42);

// Nested invocations
print math.abs(math.min(-5, -8));
