// Compare average computation: pure Lux, Float64Array get-loop, Float64Array dot
var sizes = [10, 100, 1000, 10000];

print "| N | pure_lux_s | float64_get_s | float64_dot_s |";
print "|---|---:|---:|---:|";

var si = 0;
while (si < sizes.length) {
    var N = sizes[si];

    // Pure Lux array (use index assignment for perf; array + array also works)
    var luxGrades = [];
    var i = 0;
    while (i < N) {
        luxGrades[i] = (i % 100) + 50.0;
        i = i + 1;
    }
    var start = clock();
    var sum1 = 0.0;
    i = 0;
    while (i < N) {
        sum1 = sum1 + luxGrades[i];
        i = i + 1;
    }
    var t_pure = clock() - start;

    // Float64Array: fill and ones vector
    var fa = float64_new(N);
    var ones = float64_new(N);
    i = 0;
    while (i < N) {
        float64_set(fa, i, (i % 100) + 50.0);
        float64_set(ones, i, 1.0);
        i = i + 1;
    }

    // Float64 get-loop
    start = clock();
    var sum2 = 0.0;
    i = 0;
    while (i < N) {
        sum2 = sum2 + float64_get(fa, i);
        i = i + 1;
    }
    var t_get = clock() - start;

    // Float64 dot
    start = clock();
    var total = float64_dot(fa, ones);
    var t_dot = clock() - start;

    // Print row (sums for sanity)
    print "| " + N + " | " + t_pure + " | " + t_get + " | " + t_dot + " |  // sums: " + sum1 + "," + sum2 + "," + total;

    si = si + 1;
}

