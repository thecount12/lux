fun fibFast(n) {
    if (n < 2) return n;
    var a = 0;
    var b = 1;
    var i = 2;
    while (i <= n) {
        var next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return b;
}

var N = 50;
var ROUNDS = 200000;
var checksum = 0;

var start = clock();
var i = 0;
while (i < ROUNDS) {
    checksum = checksum + fibFast(N);
    i = i + 1;
}
var elapsed = clock() - start;

print "N=" + N;
print "ROUNDS=" + ROUNDS;
print "CHECKSUM=" + checksum;
print "BENCH_TIME=" + elapsed;
