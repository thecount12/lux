// Moving average example (simple copying-based implementation)
// Float64Array is POSIX-only; on Plan 9, prints a message and skips
if (!float64_available()) {
    print "Float64Array not available. Skipping.";
} else {
var N = 10000;   // total samples
var W = 64;      // window size

// Create data and kernel
var data = float64_new(N);
var kernel = float64_new(W);
var i = 0;
while (i < W) {
    float64_set(kernel, i, 1.0 / W);
    i = i + 1;
}

i = 0;
while (i < N) {
    // some sample data (sine-ish)
    float64_set(data, i, (i % 100) * 0.01);
    i = i + 1;
}

// Compute moving average by sliding (copies into view each time)
var start = clock();
var outSum = 0.0;
var idx = 0;
var view = float64_new(W);  // Reuse single view to avoid GC pressure
while (idx + W <= N) {
    var k = 0;
    while (k < W) {
        var val = float64_get(data, idx + k);
        float64_set(view, k, val);
        k = k + 1;
    }
    var avg = float64_dot(view, kernel);
    outSum = outSum + avg;
    idx = idx + 1;
}
var t = clock() - start;
print "MOVING_AVG_TIME=" + t + " OUT_SUM=" + outSum;
}

