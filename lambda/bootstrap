#!/bin/sh
set -eu

cd /var/task

RUNTIME_API="http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime"
EVENT_PATH="/tmp/lambda_event.json"
RESPONSE_PATH="/tmp/lambda_response.json"

post_response() {
  request_id="$1"
  curl -sS -X POST "$RUNTIME_API/invocation/${request_id}/response" \
    -H "Content-Type: application/json" \
    --data-binary @"$RESPONSE_PATH" >/dev/null
}

write_error() {
  msg="$1"
  printf '%s' "{\"statusCode\":500,\"headers\":{\"content-type\":\"application/json\"},\"body\":\"{\\\"error\\\":\\\"${msg}\\\"}\"}" > "$RESPONSE_PATH"
}

while true; do
  HEADERS_PATH="$(mktemp)"

  curl -sS -L -D "$HEADERS_PATH" "$RUNTIME_API/invocation/next" -o "$EVENT_PATH"

  REQUEST_ID="$(awk '/Lambda-Runtime-Aws-Request-Id:/ {print $2}' "$HEADERS_PATH" | tr -d '\r')"
  rm -f "$HEADERS_PATH"
  rm -f "$RESPONSE_PATH" /tmp/lux_stdout.log /tmp/lux_stderr.log

  set +e
  if [ -f /var/task/handler.lux ]; then
    HANDLER=/var/task/handler.lux
  elif [ -f /var/task/lambda/handler.lux ]; then
    HANDLER=/var/task/lambda/handler.lux
  else
    echo "Missing handler.lux under /var/task. Contents:" >&2
    ls -la /var/task /var/task/lambda /var/task/lib 2>&1 >&2 || true
    HANDLER=""
  fi
  if [ -n "$HANDLER" ]; then
    /var/task/lux "$HANDLER" > /tmp/lux_stdout.log 2>/tmp/lux_stderr.log
    lux_status=$?
  else
    lux_status=74
  fi
  set -e

  if [ -s /tmp/lux_stdout.log ]; then
    cat /tmp/lux_stdout.log
  fi
  if [ -s /tmp/lux_stderr.log ]; then
    cat /tmp/lux_stderr.log >&2
  fi

  if [ "$lux_status" -eq 0 ] && [ -s "$RESPONSE_PATH" ]; then
    post_response "$REQUEST_ID"
  else
    if [ "$lux_status" -ne 0 ]; then
      write_error "lux handler execution failed"
    else
      write_error "handler produced no response file"
    fi
    post_response "$REQUEST_ID"
  fi
done
