#!/bin/sh
set -eu

RUNTIME_API="http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime"
EVENT_PATH="/tmp/lambda_event.json"
RESPONSE_PATH="/tmp/lambda_response.json"

while true; do
  HEADERS_PATH="$(mktemp)"

  curl -sS -L -D "$HEADERS_PATH" "$RUNTIME_API/invocation/next" -o "$EVENT_PATH"

  REQUEST_ID="$(awk '/Lambda-Runtime-Aws-Request-Id:/ {print $2}' "$HEADERS_PATH" | tr -d '\r')"
  rm -f "$HEADERS_PATH"

  # Clear previous response file to avoid stale responses.
  rm -f "$RESPONSE_PATH"

  # handler.lux imports lib/mangum.lux (cwd must be /var/task).
  if /var/task/lux /var/task/lambda/handler.lux > /tmp/lux_stdout.log 2>/tmp/lux_stderr.log; then
    if [ -s "$RESPONSE_PATH" ]; then
      curl -sS -X POST "$RUNTIME_API/invocation/$REQUEST_ID/response" --data-binary @"$RESPONSE_PATH" >/dev/null
    else
      printf '%s' '{"statusCode":500,"body":"{\\"error\\":\\"handler produced no response file\\"}"}' > "$RESPONSE_PATH"
      curl -sS -X POST "$RUNTIME_API/invocation/$REQUEST_ID/response" --data-binary @"$RESPONSE_PATH" >/dev/null
    fi
  else
    printf '%s' '{"statusCode":500,"body":"{\\"error\\":\\"lux handler execution failed\\"}"}' > "$RESPONSE_PATH"
    curl -sS -X POST "$RUNTIME_API/invocation/$REQUEST_ID/response" --data-binary @"$RESPONSE_PATH" >/dev/null
  fi
done
