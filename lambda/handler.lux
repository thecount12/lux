// Copied to /var/task/handler.lux and /var/runtime/handler.lux.
// Bootstrap stages those files under /tmp/luxapp (Lambda can deny fopen
// on /var/task) and runs lux from there so import "lib/mangum.lux" works.
// Event: /tmp/lambda_event.json  response: /tmp/lambda_response.json

import "lib/mangum.lux";

fun handleHome(req, res) {
    res.html("<!DOCTYPE html><html><head><title>Lux</title></head><body><h1>Hello from Lux</h1><p>Served on AWS Lambda.</p></body></html>");
}

fun handleHealth(req, res) {
    res.json(parseJSON("{\"ok\":true}"));
}

fun handleEcho(req, res) {
    var obj = parseJSON("{\"method\":\"\",\"path\":\"\",\"body\":\"\"}");
    obj.method = req.method;
    obj.path = req.path;
    obj.body = req.body;
    res.json(obj);
}

var server = Server(0);
server.get("/", handleHome);
server.get("/health", handleHealth);
server.get("/echo", handleEcho);
server.post("/echo", handleEcho);

Mangum(server);
