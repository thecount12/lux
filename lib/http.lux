// Multipart form helpers. Import has no side effects.
// Paths are relative to the process CWD:
//   import "../lib/http.lux";

class MultipartPart {
    init(name, value, path, filename, type) {
        this.name = name;
        this.value = value;
        this.path = path;
        this.filename = filename;
        this.type = type;
    }
}

class Form {
    init() {
        this.parts = [];
    }

    field(name, value) {
        if (value == nil) {
            value = "";
        } else if (typeof(value) != "string") {
            value = "" + value;
        }
        this.parts[this.parts.length] = MultipartPart(name, value, nil, nil, nil);
        return this;
    }

    file(name, path, type) {
        this.parts[this.parts.length] = MultipartPart(name, nil, path, nil, type);
        return this;
    }

    post(url, headers) {
        return httpPostForm(url, this.parts, headers);
    }
}
